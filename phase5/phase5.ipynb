    "%%writefile config.py\n",
    "\"\"\"\n",
    "Central configuration for Phase-1 Legal LM Pretraining.\n",
    "Edit paths / hyperparams here rather than scattering magic numbers in scripts.\n",
    "\"\"\"\n",
    "\n",
    "from dataclasses import dataclass, field\n",
    "from typing import Optional\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Paths\n",
    "# ---------------------------------------------------------------------------\n",
    "@dataclass\n",
    "class PathConfig:\n",
    "    train_dir: str = \"Phase_1_Pretraining/Train\"\n",
    "    test_file: str = \"Phase_1_Pretraining/Test/Phase1- Test.json\"\n",
    "    data_dir: str = \"artifacts/data\"          # tokenized shards written by prepare_data.py\n",
    "    tokenizer_out: str = \"artifacts/tokenizer.json\"\n",
    "    checkpoint_dir: str = \"artifacts/checkpoints\"\n",
    "    prediction_out: str = \"artifacts/prediction.json\"\n",
    "    submission_zip: str = \"artifacts/submission.zip\"\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Tokenizer\n",
    "# ---------------------------------------------------------------------------\n",
    "@dataclass\n",
    "class TokenizerConfig:\n",
    "    vocab_size: int = 32000\n",
    "    min_frequency: int = 2\n",
    "    special_tokens: tuple = (\"<pad>\", \"<bos>\", \"<eos>\", \"<unk>\")\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Data\n",
    "# ---------------------------------------------------------------------------\n",
    "@dataclass\n",
    "class DataConfig:\n",
    "    context_length: int = 512          # sequence length used for LM training\n",
    "    val_fraction: float = 0.02         # held-out fraction, split by document\n",
    "    # relative sampling weights per source; tune via ablation (see §7.4)\n",
    "    source_weights: dict = field(default_factory=lambda: {\n",
    "        \"train_acts\": 1.0,\n",
    "        \"train_high_courts\": 1.5,\n",
    "        \"train_supreme_court\": 1.5,\n",
    "        \"train_tribunals\": 1.0,\n",
    "    })\n",
    "    max_train_tokens: Optional[int] = 100_000_000  # cap for Tier-1 cheap search; raise for Tier-2\n",
    "    seed: int = 42\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Model — shared knobs, kept under ~300M params for every architecture\n",
    "# ---------------------------------------------------------------------------\n",
    "@dataclass\n",
    "class ModelConfig:\n",
    "    architecture: str = \"decoder_only\"   # decoder_only | enc_dec | efficient | chunk_recurrent\n",
    "    vocab_size: int = 32000\n",
    "    hidden_size: int = 768\n",
    "    num_layers: int = 12\n",
    "    num_heads: int = 12\n",
    "    num_kv_heads: int = 4          # for GQA in decoder_only / efficient\n",
    "    ffn_multiplier: float = 2.75   # SwiGLU effective expansion (~4x dense equivalent)\n",
    "    max_position_embeddings: int = 1024\n",
    "    dropout: float = 0.1\n",
    "    # efficient-architecture specific\n",
    "    local_window: int = 128\n",
    "    global_every: int = 4          # every Nth layer is full attention\n",
    "    # chunk-recurrent specific\n",
    "    chunk_size: int = 128\n",
    "    memory_size: int = 32          # summary vector width multiplier\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Training\n",
    "# ---------------------------------------------------------------------------\n",
    "@dataclass\n",
    "class TrainConfig:\n",
    "    batch_size: int = 16\n",
    "    grad_accum_steps: int = 4\n",
    "    lr: float = 3e-4\n",
    "    min_lr: float = 3e-5\n",
    "    warmup_steps: int = 500\n",
    "    max_steps: int = 20000\n",
    "    weight_decay: float = 0.1\n",
    "    grad_clip: float = 1.0\n",
    "    eval_every: int = 500\n",
    "    save_every: int = 1000\n",
    "    log_every: int = 50\n",
    "    mixed_precision: str = \"bf16\"   # \"bf16\" | \"fp16\" | \"no\"\n",
    "    compile_model: bool = True\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Generation\n",
    "# ---------------------------------------------------------------------------\n",
    "@dataclass\n",
    "class GenConfig:\n",
    "    max_new_words: int = 128\n",
    "    temperature: float = 0.8\n",
    "    top_p: float = 0.9\n",
    "    top_k: int = 50\n",
    "    repetition_penalty: float = 1.2\n",
    "    no_repeat_ngram_size: int = 4"
   ]
