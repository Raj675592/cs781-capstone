   "source": [
    "%%writefile models.py\n",
    "\"\"\"\n",
    "Four substantially different architectures for Phase-1 legal LM pretraining.\n",
    "All kept in the 50M-300M parameter range by adjusting hidden_size / num_layers\n",
    "in config.py.\n",
    "\n",
    "    1. DecoderOnlyLM        - RoPE + GQA + SwiGLU pre-norm transformer (baseline)\n",
    "    2. Seq2SeqLM            - Encoder-decoder transformer (natural fit for\n",
    "                               \"512-word prompt -> 128-word continuation\")\n",
    "    3. EfficientLocalGlobalLM - local sliding-window attention with periodic\n",
    "                               full-attention layers (cheap long-range mixing)\n",
    "    4. ChunkRecurrentLM     - novel: encodes the prompt in fixed-size chunks,\n",
    "                               compresses each chunk into a memory vector via\n",
    "                               a small recurrent update, decoder cross-attends\n",
    "                               to accumulated memory + local window\n",
    "\"\"\"\n",
    "\n",
    "import math\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# Shared primitives\n",
    "# ============================================================================\n",
    "class RMSNorm(nn.Module):\n",
    "    def __init__(self, dim, eps=1e-6):\n",
    "        super().__init__()\n",
    "        self.weight = nn.Parameter(torch.ones(dim))\n",
    "        self.eps = eps\n",
    "\n",
    "    def forward(self, x):\n",
    "        norm = x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + self.eps)\n",
    "        return norm * self.weight\n",
    "\n",
    "\n",
    "class SwiGLU(nn.Module):\n",
    "    def __init__(self, dim, mult=2.75, dropout=0.1):\n",
    "        super().__init__()\n",
    "        hidden = int(dim * mult)\n",
    "        self.w1 = nn.Linear(dim, hidden, bias=False)\n",
    "        self.w2 = nn.Linear(dim, hidden, bias=False)\n",
    "        self.w3 = nn.Linear(hidden, dim, bias=False)\n",
    "        self.drop = nn.Dropout(dropout)\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.drop(self.w3(F.silu(self.w1(x)) * self.w2(x)))\n",
    "\n",
    "\n",
    "def rotary_freqs(seq_len, head_dim, device, base=10000.0):\n",
    "    inv_freq = 1.0 / (base ** (torch.arange(0, head_dim, 2, device=device).float() / head_dim))\n",
    "    t = torch.arange(seq_len, device=device).float()\n",
    "    freqs = torch.outer(t, inv_freq)\n",
    "    return torch.cat([freqs, freqs], dim=-1)  # (seq_len, head_dim)\n",
    "\n",
    "\n",
    "def rotate_half(x):\n",
    "    x1, x2 = x.chunk(2, dim=-1)\n",
    "    return torch.cat([-x2, x1], dim=-1)\n",
    "\n",
    "\n",
    "def apply_rope(q, k, freqs):\n",
    "    cos, sin = freqs.cos(), freqs.sin()\n",
    "    cos = cos[None, None, :, :]\n",
    "    sin = sin[None, None, :, :]\n",
    "    q = (q * cos) + (rotate_half(q) * sin)\n",
    "    k = (k * cos) + (rotate_half(k) * sin)\n",
    "    return q, k\n",
    "\n",
    "\n",
    "class GQAAttention(nn.Module):\n",
    "    \"\"\"Grouped-query causal self-attention with RoPE. Supports an optional\n",
    "    additive attn_mask (for local-window / block patterns).\"\"\"\n",
    "\n",
    "    def __init__(self, dim, num_heads, num_kv_heads, dropout=0.1):\n",
    "        super().__init__()\n",
    "        assert dim % num_heads == 0\n",
    "        self.num_heads = num_heads\n",
    "        self.num_kv_heads = num_kv_heads\n",
    "        self.head_dim = dim // num_heads\n",
    "        self.q_proj = nn.Linear(dim, num_heads * self.head_dim, bias=False)\n",
    "        self.k_proj = nn.Linear(dim, num_kv_heads * self.head_dim, bias=False)\n",
    "        self.v_proj = nn.Linear(dim, num_kv_heads * self.head_dim, bias=False)\n",
    "        self.o_proj = nn.Linear(num_heads * self.head_dim, dim, bias=False)\n",
    "        self.drop = dropout\n",
    "\n",
    "    def forward(self, x, freqs, attn_mask=None):\n",
    "        B, T, _ = x.shape\n",
    "        q = self.q_proj(x).view(B, T, self.num_heads, self.head_dim).transpose(1, 2)\n",
    "        k = self.k_proj(x).view(B, T, self.num_kv_heads, self.head_dim).transpose(1, 2)\n",
    "        v = self.v_proj(x).view(B, T, self.num_kv_heads, self.head_dim).transpose(1, 2)\n",
    "\n",
    "        q, k = apply_rope(q, k, freqs)\n",
    "\n",
    "        rep = self.num_heads // self.num_kv_heads\n",
    "        k = k.repeat_interleave(rep, dim=1)\n",
    "        v = v.repeat_interleave(rep, dim=1)\n",
    "\n",
    "        out = F.scaled_dot_product_attention(\n",
    "            q, k, v,\n",
    "            attn_mask=attn_mask,\n",
    "            is_causal=attn_mask is None,\n",
    "            dropout_p=self.drop if self.training else 0.0,\n",
    "        )\n",
    "        out = out.transpose(1, 2).contiguous().view(B, T, -1)\n",
    "        return self.o_proj(out)\n",
    "\n",
    "\n",
    "def build_local_window_mask(T, window, device):\n",
    "    \"\"\"Boolean mask: True = attend. Causal + only last `window` tokens.\n",
    "    (Boolean instead of an additive float mask: SDPA rejects a float32 mask\n",
    "    when q/k/v are bf16/fp16 under autocast.)\"\"\"\n",
    "    idx = torch.arange(T, device=device)\n",
    "    causal = idx[None, :] <= idx[:, None]\n",
    "    local = (idx[:, None] - idx[None, :]) < window\n",
    "    return (causal & local)[None, None, :, :]\n",
    "\n",
    "\n",
    "def build_causal_mask(T, device):\n",
    "    idx = torch.arange(T, device=device)\n",
    "    return (idx[None, :] <= idx[:, None])[None, None, :, :]\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# 1. Decoder-only Transformer (baseline: RoPE + GQA + SwiGLU, pre-norm)\n",
    "# ============================================================================\n",
    "class DecoderBlock(nn.Module):\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.norm1 = RMSNorm(cfg.hidden_size)\n",
    "        self.attn = GQAAttention(cfg.hidden_size, cfg.num_heads, cfg.num_kv_heads, cfg.dropout)\n",
    "        self.norm2 = RMSNorm(cfg.hidden_size)\n",
    "        self.ffn = SwiGLU(cfg.hidden_size, cfg.ffn_multiplier, cfg.dropout)\n",
    "\n",
    "    def forward(self, x, freqs, attn_mask=None):\n",
    "        x = x + self.attn(self.norm1(x), freqs, attn_mask)\n",
    "        x = x + self.ffn(self.norm2(x))\n",
    "        return x\n",
    "\n",
    "\n",
    "class DecoderOnlyLM(nn.Module):\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.cfg = cfg\n",
    "        self.tok_emb = nn.Embedding(cfg.vocab_size, cfg.hidden_size)\n",
    "        self.drop = nn.Dropout(cfg.dropout)\n",
    "        self.blocks = nn.ModuleList([DecoderBlock(cfg) for _ in range(cfg.num_layers)])\n",
    "        self.norm_f = RMSNorm(cfg.hidden_size)\n",
    "        self.lm_head = nn.Linear(cfg.hidden_size, cfg.vocab_size, bias=False)\n",
    "        self.lm_head.weight = self.tok_emb.weight  # weight tying\n",
    "        self.head_dim = cfg.hidden_size // cfg.num_heads\n",
    "        self.apply(self._init_weights)\n",
    "\n",
    "    def _init_weights(self, m):\n",
    "        if isinstance(m, nn.Linear):\n",
    "            nn.init.normal_(m.weight, mean=0.0, std=0.02)\n",
    "        elif isinstance(m, nn.Embedding):\n",
    "            nn.init.normal_(m.weight, mean=0.0, std=0.02)\n",
    "\n",
    "    def forward(self, input_ids, labels=None):\n",
    "        B, T = input_ids.shape\n",
    "        x = self.drop(self.tok_emb(input_ids))\n",
    "        freqs = rotary_freqs(T, self.head_dim, input_ids.device)\n",
    "        for block in self.blocks:\n",
    "            x = block(x, freqs)\n",
    "        x = self.norm_f(x)\n",
    "        logits = self.lm_head(x)\n",
    "        loss = None\n",
    "        if labels is not None:\n",
    "            loss = F.cross_entropy(\n",
    "                logits[:, :-1].reshape(-1, logits.size(-1)),\n",
    "                labels[:, 1:].reshape(-1),\n",
    "                ignore_index=-100,\n",
    "            )\n",
    "        return logits, loss\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def generate(self, input_ids, max_new_tokens, temperature=0.8, top_p=0.9,\n",
    "                 top_k=50, repetition_penalty=1.2, no_repeat_ngram_size=4,\n",
    "                 eos_token_id=None):\n",
    "        self.eval()\n",
    "        for _ in range(max_new_tokens):\n",
    "            # BUG FIX: crop only the MODEL INPUT to the trained context. The old code overwrote `input_ids`\n",
    "            # with its own crop, so the running sequence never grew past max_pos+1 tokens and generate.py\n",
    "            # (which decodes out[0, prompt_len:]) got EMPTY text for every ctx-512 model and a truncated /\n",
    "            # corrupted tail for long prompts on the ctx-1024 model.\n",
    "            logits, _ = self.forward(input_ids[:, -self.cfg.max_position_embeddings:])\n",
    "            next_logits = logits[:, -1, :].float() / max(temperature, 1e-5)\n",
    "            next_logits[:, [0, 1, 3]] = float(\"-inf\")            # never sample <pad>/<bos>/<unk>\n",
    "            if eos_token_id is None:\n",
    "                next_logits[:, 2] = float(\"-inf\")                # ...nor <eos> (would start an unrelated document)\n",
    "            next_logits = _apply_repetition_penalty(next_logits, input_ids, repetition_penalty)\n",
    "            next_logits = _block_repeat_ngrams(next_logits, input_ids, no_repeat_ngram_size)\n",
    "            next_logits = _top_k_top_p_filter(next_logits, top_k, top_p)\n",
    "            probs = F.softmax(next_logits, dim=-1)\n",
    "            next_token = torch.multinomial(probs, num_samples=1)\n",
    "            input_ids = torch.cat([input_ids, next_token], dim=1)\n",
    "            if eos_token_id is not None and (next_token == eos_token_id).all():\n",
    "                break\n",
    "        return input_ids\n",
    "\n",
    "\n",
    "def _apply_repetition_penalty(logits, generated, penalty):\n",
    "    if penalty == 1.0:\n",
    "        return logits\n",
    "    for b in range(generated.size(0)):\n",
    "        seen = torch.unique(generated[b])\n",
    "        vals = logits[b, seen]\n",
    "        logits[b, seen] = torch.where(vals < 0, vals * penalty, vals / penalty)\n",
    "    return logits\n",
    "\n",
    "\n",
    "def _block_repeat_ngrams(logits, generated, n):\n",
    "    if n <= 0 or generated.size(1) < n:\n",
    "        return logits\n",
    "    B, T = generated.shape\n",
    "    for b in range(B):\n",
    "        seq = generated[b].tolist()\n",
    "        if len(seq) < n - 1:\n",
    "            continue\n",
    "        prefix = tuple(seq[-(n - 1):])\n",
    "        banned = set()\n",
    "        for i in range(len(seq) - n + 1):\n",
    "            if tuple(seq[i:i + n - 1]) == prefix:\n",
    "                banned.add(seq[i + n - 1])\n",
    "        for tok in banned:\n",
    "            logits[b, tok] = float(\"-inf\")\n",
    "    return logits\n",
    "\n",
    "\n",
    "def _top_k_top_p_filter(logits, top_k, top_p):\n",
    "    if top_k > 0:\n",
    "        top_k = min(top_k, logits.size(-1))\n",
    "        kth_vals = torch.topk(logits, top_k, dim=-1).values[..., -1, None]\n",
    "        logits = torch.where(logits < kth_vals, torch.full_like(logits, float(\"-inf\")), logits)\n",
    "    if top_p < 1.0:\n",
    "        sorted_logits, sorted_idx = torch.sort(logits, descending=True, dim=-1)\n",
    "        probs = F.softmax(sorted_logits, dim=-1)\n",
    "        cum_probs = torch.cumsum(probs, dim=-1)\n",
    "        remove = cum_probs > top_p\n",
    "        remove[..., 1:] = remove[..., :-1].clone()\n",
    "        remove[..., 0] = False\n",
    "        sorted_logits[remove] = float(\"-inf\")\n",
    "        logits = torch.full_like(logits, float(\"-inf\")).scatter(-1, sorted_idx, sorted_logits)\n",
    "    return logits\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# 2. Encoder-Decoder Transformer (natural fit: prompt -> continuation)\n",
    "# ============================================================================\n",
    "class EncoderLayer(nn.Module):\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.norm1 = RMSNorm(cfg.hidden_size)\n",
    "        self.attn = nn.MultiheadAttention(cfg.hidden_size, cfg.num_heads,\n",
    "                                           dropout=cfg.dropout, batch_first=True)\n",
    "        self.norm2 = RMSNorm(cfg.hidden_size)\n",
    "        self.ffn = SwiGLU(cfg.hidden_size, cfg.ffn_multiplier, cfg.dropout)\n",
    "\n",
    "    def forward(self, x, key_padding_mask=None):\n",
    "        h = self.norm1(x)\n",
    "        attn_out, _ = self.attn(h, h, h, key_padding_mask=key_padding_mask, need_weights=False)\n",
    "        x = x + attn_out\n",
    "        x = x + self.ffn(self.norm2(x))\n",
    "        return x\n",
    "\n",
    "\n",
    "class DecoderLayerCross(nn.Module):\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.norm1 = RMSNorm(cfg.hidden_size)\n",
    "        self.self_attn = nn.MultiheadAttention(cfg.hidden_size, cfg.num_heads,\n",
    "                                                dropout=cfg.dropout, batch_first=True)\n",
    "        self.norm2 = RMSNorm(cfg.hidden_size)\n",
    "        self.cross_attn = nn.MultiheadAttention(cfg.hidden_size, cfg.num_heads,\n",
    "                                                 dropout=cfg.dropout, batch_first=True)\n",
    "        self.norm3 = RMSNorm(cfg.hidden_size)\n",
    "        self.ffn = SwiGLU(cfg.hidden_size, cfg.ffn_multiplier, cfg.dropout)\n",
    "\n",
    "    def forward(self, x, memory, self_mask, mem_key_padding_mask=None):\n",
    "        h = self.norm1(x)\n",
    "        sa, _ = self.self_attn(h, h, h, attn_mask=self_mask, need_weights=False)\n",
    "        x = x + sa\n",
    "        h = self.norm2(x)\n",
    "        ca, _ = self.cross_attn(h, memory, memory,\n",
    "                                 key_padding_mask=mem_key_padding_mask, need_weights=False)\n",
    "        x = x + ca\n",
    "        x = x + self.ffn(self.norm3(x))\n",
    "        return x\n",
    "\n",
    "\n",
    "class Seq2SeqLM(nn.Module):\n",
    "    \"\"\"Encoder reads the 512-word prompt; decoder autoregressively produces\n",
    "    the continuation. Uses learned positional embeddings (simplest to reason\n",
    "    about across two separate sequences).\"\"\"\n",
    "\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.cfg = cfg\n",
    "        half_layers = max(1, cfg.num_layers // 2)\n",
    "        self.tok_emb = nn.Embedding(cfg.vocab_size, cfg.hidden_size)\n",
    "        self.pos_emb = nn.Embedding(cfg.max_position_embeddings, cfg.hidden_size)\n",
    "        self.drop = nn.Dropout(cfg.dropout)\n",
    "        self.encoder = nn.ModuleList([EncoderLayer(cfg) for _ in range(half_layers)])\n",
    "        self.decoder = nn.ModuleList([DecoderLayerCross(cfg) for _ in range(half_layers)])\n",
    "        self.norm_f = RMSNorm(cfg.hidden_size)\n",
    "        self.lm_head = nn.Linear(cfg.hidden_size, cfg.vocab_size, bias=False)\n",
    "        self.lm_head.weight = self.tok_emb.weight\n",
    "        self.apply(self._init_weights)\n",
    "\n",
    "    def _init_weights(self, m):\n",
    "        if isinstance(m, (nn.Linear, nn.Embedding)):\n",
    "            nn.init.normal_(m.weight, mean=0.0, std=0.02)\n",
    "\n",
    "    def _embed(self, ids):\n",
    "        T = ids.size(1)\n",
    "        pos = torch.arange(T, device=ids.device).unsqueeze(0)\n",
    "        return self.drop(self.tok_emb(ids) + self.pos_emb(pos))\n",
    "\n",
    "    def encode(self, src_ids, src_padding_mask=None):\n",
    "        x = self._embed(src_ids)\n",
    "        for layer in self.encoder:\n",
    "            x = layer(x, key_padding_mask=src_padding_mask)\n",
    "        return x\n",
    "\n",
    "    def forward(self, src_ids, tgt_ids, labels=None, src_padding_mask=None):\n",
    "        memory = self.encode(src_ids, src_padding_mask)\n",
    "        x = self._embed(tgt_ids)\n",
    "        T = tgt_ids.size(1)\n",
    "        causal = torch.triu(torch.full((T, T), float(\"-inf\"), device=tgt_ids.device), diagonal=1)\n",
    "        for layer in self.decoder:\n",
    "            x = layer(x, memory, causal, mem_key_padding_mask=src_padding_mask)\n",
    "        x = self.norm_f(x)\n",
    "        logits = self.lm_head(x)\n",
    "        loss = None\n",
    "        if labels is not None:\n",
    "            loss = F.cross_entropy(\n",
    "                logits[:, :-1].reshape(-1, logits.size(-1)),\n",
    "                labels[:, 1:].reshape(-1),\n",
    "                ignore_index=-100,\n",
    "            )\n",
    "        return logits, loss\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def generate(self, src_ids, bos_id, eos_id, max_new_tokens, temperature=0.8,\n",
    "                 top_p=0.9, top_k=50, repetition_penalty=1.2, no_repeat_ngram_size=4,\n",
    "                 src_padding_mask=None):\n",
    "        self.eval()\n",
    "        memory = self.encode(src_ids, src_padding_mask)\n",
    "        tgt = torch.full((src_ids.size(0), 1), bos_id, dtype=torch.long, device=src_ids.device)\n",
    "        for _ in range(max_new_tokens):\n",
    "            x = self._embed(tgt)\n",
    "            T = tgt.size(1)\n",
    "            causal = torch.triu(torch.full((T, T), float(\"-inf\"), device=tgt.device), diagonal=1)\n",
    "            h = x\n",
    "            for layer in self.decoder:\n",
    "                h = layer(h, memory, causal, mem_key_padding_mask=src_padding_mask)\n",
    "            h = self.norm_f(h)\n",
    "            next_logits = self.lm_head(h)[:, -1, :].float() / max(temperature, 1e-5)\n",
    "            next_logits[:, [0, 1, 3]] = float(\"-inf\")            # never sample <pad>/<bos>/<unk> (<eos> ends the target)\n",
    "            next_logits = _apply_repetition_penalty(next_logits, tgt, repetition_penalty)\n",
    "            next_logits = _block_repeat_ngrams(next_logits, tgt, no_repeat_ngram_size)\n",
    "            next_logits = _top_k_top_p_filter(next_logits, top_k, top_p)\n",
    "            probs = F.softmax(next_logits, dim=-1)\n",
    "            next_token = torch.multinomial(probs, num_samples=1)\n",
    "            tgt = torch.cat([tgt, next_token], dim=1)\n",
    "            if (next_token == eos_id).all():\n",
    "                break\n",
    "        return tgt\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# 3. Efficient / lightweight Transformer: local sliding-window attention with\n",
    "#    periodic full-attention layers for global mixing.\n",
    "# ============================================================================\n",
    "class EfficientLocalGlobalLM(nn.Module):\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.cfg = cfg\n",
    "        self.tok_emb = nn.Embedding(cfg.vocab_size, cfg.hidden_size)\n",
    "        self.drop = nn.Dropout(cfg.dropout)\n",
    "        self.blocks = nn.ModuleList([DecoderBlock(cfg) for _ in range(cfg.num_layers)])\n",
    "        self.norm_f = RMSNorm(cfg.hidden_size)\n",
    "        self.lm_head = nn.Linear(cfg.hidden_size, cfg.vocab_size, bias=False)\n",
    "        self.lm_head.weight = self.tok_emb.weight\n",
    "        self.head_dim = cfg.hidden_size // cfg.num_heads\n",
    "        self.apply(self._init_weights)\n",
    "\n",
    "    def _init_weights(self, m):\n",
    "        if isinstance(m, (nn.Linear, nn.Embedding)):\n",
    "            nn.init.normal_(m.weight, mean=0.0, std=0.02)\n",
    "\n",
    "    def forward(self, input_ids, labels=None):\n",
    "        B, T = input_ids.shape\n",
    "        x = self.drop(self.tok_emb(input_ids))\n",
    "        freqs = rotary_freqs(T, self.head_dim, input_ids.device)\n",
    "        local_mask = build_local_window_mask(T, self.cfg.local_window, input_ids.device)\n",
    "        full_mask = build_causal_mask(T, input_ids.device)\n",
    "        for i, block in enumerate(self.blocks):\n",
    "            is_global = (i + 1) % self.cfg.global_every == 0\n",
    "            mask = full_mask if is_global else local_mask\n",
    "            x = block(x, freqs, attn_mask=mask)\n",
    "        x = self.norm_f(x)\n",
    "        logits = self.lm_head(x)\n",
    "        loss = None\n",
    "        if labels is not None:\n",
    "            loss = F.cross_entropy(\n",
    "                logits[:, :-1].reshape(-1, logits.size(-1)),\n",
    "                labels[:, 1:].reshape(-1),\n",
    "                ignore_index=-100,\n",
    "            )\n",
    "        return logits, loss\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def generate(self, input_ids, max_new_tokens, **kw):\n",
    "        self.eval()\n",
    "        for _ in range(max_new_tokens):\n",
    "            logits, _ = self.forward(input_ids[:, -self.cfg.max_position_embeddings:])   # crop the input only (bug fix)\n",
    "            next_logits = logits[:, -1, :].float() / max(kw.get(\"temperature\", 0.8), 1e-5)\n",
    "            next_logits[:, [0, 1, 3]] = float(\"-inf\")            # never sample <pad>/<bos>/<unk>\n",
    "            if kw.get(\"eos_token_id\") is None:\n",
    "                next_logits[:, 2] = float(\"-inf\")                # ...nor <eos>\n",
    "            next_logits = _apply_repetition_penalty(next_logits, input_ids, kw.get(\"repetition_penalty\", 1.2))\n",
    "            next_logits = _block_repeat_ngrams(next_logits, input_ids, kw.get(\"no_repeat_ngram_size\", 4))\n",
    "            next_logits = _top_k_top_p_filter(next_logits, kw.get(\"top_k\", 50), kw.get(\"top_p\", 0.9))\n",
    "            probs = F.softmax(next_logits, dim=-1)\n",
    "            next_token = torch.multinomial(probs, num_samples=1)\n",
    "            input_ids = torch.cat([input_ids, next_token], dim=1)\n",
    "            if kw.get(\"eos_token_id\") is not None and (next_token == kw[\"eos_token_id\"]).all():\n",
    "                break\n",
    "        return input_ids\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# 4. Chunk-Recurrent Hybrid (novel architecture):\n",
    "#    Prompt is split into fixed-size chunks. Each chunk is summarized into a\n",
    "#    memory vector via a GRU-style recurrent update (memory carried across\n",
    "#    chunks, cheap O(T) alternative to full attention over very long\n",
    "#    contexts). The decoder then does local causal attention over recent\n",
    "#    tokens PLUS cross-attention to the accumulated memory bank -- letting it\n",
    "#    reference facts from far earlier in a long legal prompt (e.g. an early\n",
    "#    citation or defined term) without full quadratic attention.\n",
    "# ============================================================================\n",
    "class ChunkEncoder(nn.Module):\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.chunk_size = cfg.chunk_size\n",
    "        self.hidden = cfg.hidden_size\n",
    "        self.intra_chunk_attn = nn.MultiheadAttention(cfg.hidden_size, cfg.num_heads,\n",
    "                                                        dropout=cfg.dropout, batch_first=True)\n",
    "        self.norm = RMSNorm(cfg.hidden_size)\n",
    "        self.summarize = nn.Linear(cfg.hidden_size, cfg.hidden_size)\n",
    "        self.recurrent_update = nn.GRUCell(cfg.hidden_size, cfg.hidden_size)\n",
    "\n",
    "    def forward(self, x):\n",
    "        \"\"\"x: (B, T, H) prompt embeddings. Returns memory bank (B, num_chunks, H).\"\"\"\n",
    "        B, T, H = x.shape\n",
    "        n_chunks = math.ceil(T / self.chunk_size)\n",
    "        pad = n_chunks * self.chunk_size - T\n",
    "        if pad > 0:\n",
    "            x = F.pad(x, (0, 0, 0, pad))\n",
    "        chunks = x.view(B, n_chunks, self.chunk_size, H)\n",
    "\n",
    "        state = torch.zeros(B, H, device=x.device, dtype=x.dtype)\n",
    "        memories = []\n",
    "        for c in range(n_chunks):\n",
    "            seg = chunks[:, c]                      # (B, chunk_size, H)\n",
    "            h = self.norm(seg)\n",
    "            attn_out, _ = self.intra_chunk_attn(h, h, h, need_weights=False)\n",
    "            seg = seg + attn_out\n",
    "            pooled = self.summarize(seg.mean(dim=1))  # (B, H) mean-pool the chunk\n",
    "            state = self.recurrent_update(pooled, state)\n",
    "            memories.append(state)\n",
    "        return torch.stack(memories, dim=1)  # (B, n_chunks, H)\n",
    "\n",
    "\n",
    "class ChunkRecurrentBlock(nn.Module):\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.norm1 = RMSNorm(cfg.hidden_size)\n",
    "        self.self_attn = GQAAttention(cfg.hidden_size, cfg.num_heads, cfg.num_kv_heads, cfg.dropout)\n",
    "        self.norm2 = RMSNorm(cfg.hidden_size)\n",
    "        self.cross_attn = nn.MultiheadAttention(cfg.hidden_size, cfg.num_heads,\n",
    "                                                 dropout=cfg.dropout, batch_first=True)\n",
    "        self.norm3 = RMSNorm(cfg.hidden_size)\n",
    "        self.ffn = SwiGLU(cfg.hidden_size, cfg.ffn_multiplier, cfg.dropout)\n",
    "\n",
    "    def forward(self, x, freqs, memory, mem_mask=None):\n",
    "        x = x + self.self_attn(self.norm1(x), freqs)  # causal self-attn\n",
    "        h = self.norm2(x)\n",
    "        ca, _ = self.cross_attn(h, memory, memory, attn_mask=mem_mask, need_weights=False)\n",
    "        x = x + ca\n",
    "        x = x + self.ffn(self.norm3(x))\n",
    "        return x\n",
    "\n",
    "\n",
    "class ChunkRecurrentLM(nn.Module):\n",
    "    \"\"\"Decoder-only interface (matches the pure-continuation task) but with\n",
    "    chunk-recurrent memory injected via cross-attention at every layer.\"\"\"\n",
    "\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.cfg = cfg\n",
    "        self.tok_emb = nn.Embedding(cfg.vocab_size, cfg.hidden_size)\n",
    "        self.drop = nn.Dropout(cfg.dropout)\n",
    "        self.chunk_encoder = ChunkEncoder(cfg)\n",
    "        self.blocks = nn.ModuleList([ChunkRecurrentBlock(cfg) for _ in range(cfg.num_layers)])\n",
    "        self.norm_f = RMSNorm(cfg.hidden_size)\n",
    "        self.lm_head = nn.Linear(cfg.hidden_size, cfg.vocab_size, bias=False)\n",
    "        self.lm_head.weight = self.tok_emb.weight\n",
    "        self.head_dim = cfg.hidden_size // cfg.num_heads\n",
    "        # learned \"empty memory\" slot so tokens in the first chunk have something to attend to\n",
    "        self.null_mem = nn.Parameter(torch.zeros(1, 1, cfg.hidden_size))\n",
    "        self.apply(self._init_weights)\n",
    "        nn.init.normal_(self.null_mem, mean=0.0, std=0.02)\n",
    "\n",
    "    def _init_weights(self, m):\n",
    "        if isinstance(m, (nn.Linear, nn.Embedding)):\n",
    "            nn.init.normal_(m.weight, mean=0.0, std=0.02)\n",
    "\n",
    "    def forward(self, input_ids, labels=None):\n",
    "        B, T = input_ids.shape\n",
    "        x = self.drop(self.tok_emb(input_ids))\n",
    "        freqs = rotary_freqs(T, self.head_dim, input_ids.device)\n",
    "        memory = self.chunk_encoder(x.detach())            # (B, n_chunks, H): summary of chunk c\n",
    "        n_chunks = memory.size(1)\n",
    "        memory = torch.cat([self.null_mem.expand(B, -1, -1).to(memory.dtype), memory], dim=1)  # slot 0 = empty\n",
    "        # CAUSALITY FIX: a token in chunk c may only read slot 0 and the summaries of chunks 0..c-1\n",
    "        # (slots 1..c). The old code let every token read every chunk, including the chunk that\n",
    "        # contains the very token it is asked to predict, so its val loss was artificially low.\n",
    "        chunk_id = torch.arange(T, device=input_ids.device) // self.cfg.chunk_size\n",
    "        slot = torch.arange(n_chunks + 1, device=input_ids.device)\n",
    "        mem_mask = slot[None, :] > chunk_id[:, None]        # True = NOT allowed\n",
    "        for block in self.blocks:\n",
    "            x = block(x, freqs, memory, mem_mask)\n",
    "        x = self.norm_f(x)\n",
    "        logits = self.lm_head(x)\n",
    "        loss = None\n",
    "        if labels is not None:\n",
    "            loss = F.cross_entropy(\n",
    "                logits[:, :-1].reshape(-1, logits.size(-1)),\n",
    "                labels[:, 1:].reshape(-1),\n",
    "                ignore_index=-100,\n",
    "            )\n",
    "        return logits, loss\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def generate(self, input_ids, max_new_tokens, **kw):\n",
    "        self.eval()\n",
    "        for _ in range(max_new_tokens):\n",
    "            logits, _ = self.forward(input_ids[:, -self.cfg.max_position_embeddings:])   # crop the input only (bug fix)\n",
    "            next_logits = logits[:, -1, :].float() / max(kw.get(\"temperature\", 0.8), 1e-5)\n",
    "            next_logits[:, [0, 1, 3]] = float(\"-inf\")            # never sample <pad>/<bos>/<unk>\n",
    "            if kw.get(\"eos_token_id\") is None:\n",
    "                next_logits[:, 2] = float(\"-inf\")                # ...nor <eos>\n",
    "            next_logits = _apply_repetition_penalty(next_logits, input_ids, kw.get(\"repetition_penalty\", 1.2))\n",
    "            next_logits = _block_repeat_ngrams(next_logits, input_ids, kw.get(\"no_repeat_ngram_size\", 4))\n",
    "            next_logits = _top_k_top_p_filter(next_logits, kw.get(\"top_k\", 50), kw.get(\"top_p\", 0.9))\n",
    "            probs = F.softmax(next_logits, dim=-1)\n",
    "            next_token = torch.multinomial(probs, num_samples=1)\n",
    "            input_ids = torch.cat([input_ids, next_token], dim=1)\n",
    "            if kw.get(\"eos_token_id\") is not None and (next_token == kw[\"eos_token_id\"]).all():\n",
    "                break\n",
    "        return input_ids\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# Factory + param counting\n",
    "# ============================================================================\n",
    "def build_model(cfg):\n",
    "    arch = cfg.architecture\n",
    "    if arch == \"decoder_only\":\n",
    "        return DecoderOnlyLM(cfg)\n",
    "    if arch == \"enc_dec\":\n",
    "        return Seq2SeqLM(cfg)\n",
    "    if arch == \"efficient\":\n",
    "        return EfficientLocalGlobalLM(cfg)\n",
    "    if arch == \"chunk_recurrent\":\n",
    "        return ChunkRecurrentLM(cfg)\n",
    "    raise ValueError(f\"Unknown architecture: {arch}\")\n",
    "\n",
    "\n",
    "def count_params(model):\n",
    "    return sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# Checkpoint / AMP helpers shared by train / eval / generate / distill\n",
    "# ============================================================================\n",
    "def get_amp_dtype():\n",
    "    \"\"\"bf16 on Ampere+ GPUs, fp16 on T4/P100 (no native bf16), None on CPU.\"\"\"\n",
    "    if not torch.cuda.is_available():\n",
    "        return None\n",
    "    return torch.bfloat16 if torch.cuda.get_device_capability()[0] >= 8 else torch.float16\n",
    "\n",
    "\n",
    "def load_checkpoint(path, device):\n",
    "    \"\"\"Load a checkpoint written by train.py / distill.py. Configs are stored as plain dicts,\n",
    "    so this works on torch>=2.6 where torch.load defaults to weights_only=True and cannot\n",
    "    unpickle a dataclass (the old torch.load(path) calls would have failed).\"\"\"\n",
    "    from config import ModelConfig\n",
    "    ckpt = torch.load(path, map_location=device, weights_only=False)\n",
    "    cfg = ckpt[\"config\"]\n",
    "    if isinstance(cfg, dict):\n",
    "        cfg = ModelConfig(**cfg)\n",
    "    model = build_model(cfg).to(device)\n",
    "    model.load_state_dict(ckpt[\"model\"])\n",
    "    model.eval()\n",
    "    return model, cfg, ckpt"
   ]
  },
