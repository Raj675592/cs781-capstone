    "    with zipfile.ZipFile(f\"{OUT}/submissions/{name}.zip\", \"w\", zipfile.ZIP_DEFLATED) as z: z.write(f\"{d}/prediction.json\", \"prediction.json\")\n",
    "    return preds\n",
    "\n",
    "for n, r in CANDS.items(): write_submission(r[\"test_pred\"], n)\n",
    "final_preds = write_submission(FINAL[\"test_pred\"], \"FINAL\")\n",
    "neural_preds = write_submission(FINAL_NEURAL[\"test_pred\"], \"FINAL_neural_only\")\n",
    "shutil.copy(f\"{OUT}/submissions/FINAL/prediction.json\", f\"{OUT}/prediction.json\")\n",
    "shutil.copy(f\"{OUT}/submissions/FINAL.zip\", f\"{OUT}/submission.zip\")\n",
    "\n",
    "# ---------------- format validation ----------------\n",
    "for nm, fp in ((\"FINAL\", final_preds), (\"FINAL_neural_only\", neural_preds)):\n",
    "    assert len(fp) == N_TE and [p[\"id\"] for p in fp] == list(te_ids), \"one prediction per test document, same ids\"\n",
