    "def _first(d, keys, default=None):\n",
    "    for k in keys:\n",
    "        if k in d and d[k] is not None: return d[k]\n",
    "    return default\n",
    "\n",
    "def _norm(rid, r):\n",
    "    if isinstance(r, str):\n",
    "        return rid, r, None\n",
    "    text = _first(r, [\"text\", \"document\", \"case_text\", \"judgment\", \"content\", \"doc\"], \"\")\n",
    "    if isinstance(text, list): text = \" \".join(str(x) for x in text)\n",
    "    labs = _first(r, [\"labels\", \"label\", \"statutes\", \"statute_ids\", \"pred\"], None)\n",
    "    if labs is not None:\n",
    "        if not isinstance(labs, (list, tuple)): labs = [labs]\n",
    "        labs = [int(x) for x in labs]\n",
    "    return rid, str(text), labs\n",
    "\n",
    "def load_records(path):\n",
    "    with open(path, \"r\", encoding=\"utf-8\") as f: raw = json.load(f)\n",
    "    if isinstance(raw, dict):\n",
    "        lists = [v for v in raw.values() if isinstance(v, list) and v and isinstance(v[0], dict)]\n",
    "        if len(lists) == 1 and len(raw) <= 4: raw = lists[0]\n",
    "    out = []\n",
    "    if isinstance(raw, list):\n",
    "        for i, r in enumerate(raw):\n",
    "            rid = r.get(\"id\", r.get(\"case_id\", i)) if isinstance(r, dict) else i\n",
    "            out.append(_norm(rid, r))\n",
    "    else:\n",
    "        for k, r in raw.items():\n",
    "            out.append(_norm(k, r))\n",
    "    return out\n",
    "\n",
    "tr_rec, dv_rec, te_rec = load_records(TRAIN_FILE), load_records(DEV_FILE), load_records(TEST_FILE)\n",
    "tr_ids, tr_txt, tr_lab = zip(*tr_rec); dv_ids, dv_txt, dv_lab = zip(*dv_rec); te_ids, te_txt, _ = zip(*te_rec)\n",
    "tr_txt, dv_txt, te_txt = list(tr_txt), list(dv_txt), list(te_txt)\n",
    "assert all(l is not None for l in tr_lab) and all(l is not None for l in dv_lab), \"labels missing in train/dev\"\n",
    "if QUICK:\n",
    "    tr_ids, tr_txt, tr_lab = tr_ids[:120], tr_txt[:120], tr_lab[:120]\n",
    "    dv_ids, dv_txt, dv_lab = dv_ids[:60], dv_txt[:60], dv_lab[:60]\n",
    "    te_ids, te_txt = te_ids[:40], te_txt[:40]\n",
    "\n",
    "LABELS = sorted({l for ls in list(tr_lab) + list(dv_lab) for l in ls})\n",
    "L = len(LABELS); LAB2IDX = {l: i for i, l in enumerate(LABELS)}\n",
    "def to_Y(labs):\n",
    "    Y = np.zeros((len(labs), L), dtype=np.float32)\n",
    "    for i, ls in enumerate(labs):\n",
    "        for l in ls: Y[i, LAB2IDX[l]] = 1\n",
    "    return Y\n",
    "Y_tr, Y_dv = to_Y(tr_lab), to_Y(dv_lab)\n",
    "N_TR, N_DV, N_TE = len(tr_txt), len(dv_txt), len(te_txt)\n",
    "npos = Y_tr.sum(0)\n",
    "print(f\"train {N_TR} | dev {N_DV} | test {N_TE} | labels {L}\")\n",
    "print(f\"labels/doc: train {Y_tr.sum(1).mean():.2f}, dev {Y_dv.sum(1).mean():.2f} | words/doc (median): {int(np.median([len(t.split()) for t in tr_txt[:2000]]))}\")\n",
    "print(f\"rare labels (<5 train positives): {(npos<5).sum()} | unseen in train: {(npos==0).sum()} | most frequent label share: {npos.max()/N_TR:.2%}\")\n"
