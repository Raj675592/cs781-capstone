    "## 8. Experiments"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5b752e63",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---------------- experiment definitions ----------------\n",
    "def _kd_arch():\n",
    "    return \"enc_dec\" if \"enc_dec\" in CKPTS else sorted(CKPTS)[0]\n",
    "\n",
    "EXPS = [\n",
    "    dict(name=\"exp1_lorma_decoder_only\", arch=\"decoder_only\", method=\"lorma\", technique=\"LoRMA (multiplicative low-rank)\",\n",
    "         r=16, alpha=32, lr_peft=6e-4, lr_head=2e-3, loss=\"bce\", epochs=6, teacher=True),\n",
    "    dict(name=\"exp2_partial_ft_efficient\", arch=\"efficient\", method=\"partial\", technique=\"Partial / layer-wise fine-tuning\",\n",
    "         unfreeze_frac=0.5, lr_backbone=1e-4, lr_decay=0.85, lr_head=2e-3, loss=\"bce\", epochs=6, teacher=True),\n",
    "    dict(name=\"exp3_adapters_chunk_recurrent\", arch=\"chunk_recurrent\", method=\"adapters\", technique=\"Bottleneck adapters + ASL loss\",\n",
    "         bottleneck=64, lr_peft=6e-4, lr_head=2e-3, loss=\"asl\", epochs=6, teacher=True),\n",
    "    dict(name=\"exp4_kd_student\", arch=_kd_arch(), method=\"kd\", technique=\"Knowledge distillation (full FT student)\",\n",
    "         lr_backbone=8e-5, lr_head=2e-3, loss=\"bce\", epochs=6, teacher=False),\n",
    "]\n",
    "EXPS.append(dict(name=\"exp5_kd_encoder_long\", arch=_kd_arch(), method=\"kd\", technique=\"Knowledge distillation (full FT, EMA, longer)\",\n",
    "                 lr_backbone=1e-4, lr_head=2e-3, loss=\"bce\", epochs=8, teacher=False, dropout=0.15,\n",
    "                 budget_min=EXP5_BUDGET_MIN, k_train=6, ema=0.999, seed=1337))\n",
    "EXPS = [e for e in EXPS if e[\"arch\"] in CKPTS]\n",
    "print([ (e[\"name\"], e[\"arch\"]) for e in EXPS])\n",
    "RESULTS = {}      # name -> dict(dev_logits, test_logits, info, ...)\n",
    "\n",
    "def _paths(name):\n",
    "    return dict(npz=f\"{OUT}/cache/{name}.npz\", state=f\"{OUT}/states/{name}.pt\", info=f\"{OUT}/cache/{name}.json\",\n",
    "                teacher=f\"{OUT}/cache/{name}_teacher_train.npz\")\n",
    "\n",
    "def teacher_doc_subset():\n",
    "    rng = np.random.default_rng(SEED + 1)\n",
    "    n = min(N_TR, HP[\"kd_docs\"])\n",
    "    return np.sort(rng.choice(N_TR, size=n, replace=False))\n",
    "\n",
    "def compute_teacher_logits(model, exp, clen):\n",
    "    P = _paths(exp[\"name\"])\n",
    "    if os.path.exists(P[\"teacher\"]) and not FORCE_RERUN: return\n",
    "    idx = teacher_doc_subset(); vtr = get_views(\"train\", clen)\n",
    "    sub = [vtr[i][:HP[\"kd_chunks\"]] if len(vtr[i]) <= HP[\"kd_chunks\"] else\n",
    "           [vtr[i][j] for j in sorted(set(np.linspace(0, len(vtr[i]) - 1, HP[\"kd_chunks\"]).round().astype(int).tolist()))] for i in idx]\n",
    "    t0 = time.time(); lg = predict_logits(model, sub)\n",
    "    np.savez_compressed(P[\"teacher\"], idx=idx, logits=lg.astype(np.float16))\n",
    "    print(f\"  teacher logits for {len(idx)} train docs computed in {(time.time()-t0)/60:.1f} min\")\n",
    "\n",
    "def load_teacher_targets():\n",
    "    \"\"\"Average teacher logits of every finished teacher experiment -> (N_TR, L) float32 with NaN where no teacher signal.\"\"\"\n",
    "    Z, cnt = np.zeros((N_TR, L), np.float32), np.zeros(N_TR, np.float32); used = []\n",
    "    for e in EXPS:\n",
    "        if not e.get(\"teacher\"): continue\n",
    "        p = _paths(e[\"name\"])[\"teacher\"]\n",
    "        if not os.path.exists(p): continue\n",
    "        d = np.load(p); Z[d[\"idx\"]] += d[\"logits\"].astype(np.float32); cnt[d[\"idx\"]] += 1; used.append(e[\"name\"])\n",
    "    Z[cnt > 0] /= cnt[cnt > 0, None]; Z[cnt == 0] = np.nan\n",
    "    return Z, used\n",
    "\n",
    "def run_experiment(exp):\n",
    "    name, arch = exp[\"name\"], exp[\"arch\"]; P = _paths(name)\n",
    "    print(\"\\n\" + \"=\" * 100 + f\"\\n{name}  |  Phase-1 model: {arch}  |  {exp['technique']}\\n\" + \"=\" * 100, flush=True)\n",
    "    done = os.path.exists(P[\"npz\"]) and os.path.exists(P[\"info\"]) and not FORCE_RERUN\n",
    "    need_teacher = exp.get(\"teacher\") and not os.path.exists(P[\"teacher\"]) and os.path.exists(P[\"state\"])\n",
    "    if done and not need_teacher:\n",
    "        d = np.load(P[\"npz\"]); RESULTS[name] = dict(dev=d[\"dev\"], test=d[\"test\"], info=json.load(open(P[\"info\"]))); print(\"  cached -> skipped\"); return\n",
    "    set_seed(exp.get(\"seed\", SEED))\n",
    "    model, groups, cfg = build_classifier(exp)\n",
    "    clen = chunk_len_for(cfg)\n",
    "    tot, trn = n_params(model), n_params(model, True)\n",
    "    print(f\"  backbone+head params {tot/1e6:.1f}M | trainable {trn/1e6:.2f}M ({100*trn/tot:.1f}%) | chunk_len {clen}\")\n",
    "    vtr, vdv, vte = get_views(\"train\", clen), get_views(\"dev\", clen), get_views(\"test\", clen)\n",
    "    model.to(DEVICE)\n",
    "    if done or (os.path.exists(P[\"state\"]) and not FORCE_RERUN):\n",
    "        load_state(model, P[\"state\"]); info = json.load(open(P[\"info\"])) if os.path.exists(P[\"info\"]) else {}\n",
    "        print(\"  trained weights restored from cache\")\n",
    "    else:\n",
    "        rs = np.random.default_rng(SEED + 7)\n",
    "        sub = np.sort(rs.choice(N_DV, size=min(N_DV, HP[\"dev_eval_docs\"]), replace=False))\n",
    "        kd = None\n",
    "        if exp[\"method\"] == \"kd\":\n",
    "            Z, used = load_teacher_targets()\n",
    "            print(f\"  teachers used: {used} | docs with teacher signal: {int((~np.isnan(Z).any(1)).sum())}/{N_TR}\")\n",
    "            if used: kd = (Z, HP[\"kd_T\"], HP[\"kd_alpha\"])\n",
    "            else: print(\"  WARNING: no teacher logits available - training the student with hard labels only\")\n",
    "        info = train_model(model, groups, exp, vtr, [vdv[i] for i in sub], Y_dv[sub], kd=kd)\n",
    "        save_state(model, P[\"state\"])\n",
    "    t0 = time.time(); dev_lg = predict_logits(model, vdv); t_dev = time.time() - t0\n",
    "    te0 = time.time(); te_lg = predict_logits(model, vte)\n",
    "    info.update(name=name, arch=arch, technique=exp[\"technique\"], params_M=tot / 1e6, trainable_M=trn / 1e6,\n",
    "                infer_docs_per_s=N_DV / max(t_dev, 1e-6), infer_peak_mem_gb=(torch.cuda.max_memory_allocated() / 1e9 if DEVICE == \"cuda\" else 0.0),\n",
    "                chunk_len=clen)\n",
    "    np.savez_compressed(P[\"npz\"], dev=dev_lg, test=te_lg); json.dump(info, open(P[\"info\"], \"w\"), default=float)\n",
    "    RESULTS[name] = dict(dev=dev_lg, test=te_lg, info=info)\n",
    "    g, f = best_global(sigmoid(dev_lg), Y_dv)\n",
    "    print(f\"  FULL dev macro-F1 (global thr {g:.2f}): {f:.4f} | inference {info['infer_docs_per_s']:.1f} docs/s\")\n",
    "    if exp.get(\"teacher\") and any(e[\"method\"] == \"kd\" for e in EXPS):\n",
    "        compute_teacher_logits(model, exp, clen)\n",
    "    del model, groups; gc.collect()\n",
    "    if DEVICE == \"cuda\": torch.cuda.empty_cache()\n",
    "\n",
    "def run_safe(exp):\n",
    "    try:\n",
    "        run_experiment(exp)\n",
    "    except Exception:\n",
    "        print(f\"\\n!!! {exp['name']} FAILED - continuing with the others. Traceback:\\n\" + traceback.format_exc())\n",
    "        gc.collect()\n",
    "        if DEVICE == \"cuda\": torch.cuda.empty_cache()\n"
   ]
  },
