    "AMP_DTYPE = get_amp_dtype()\n",
    "def amp(enabled=True):\n",
    "    return torch.autocast(device_type=\"cuda\", dtype=AMP_DTYPE or torch.float16,\n",
    "                          enabled=(DEVICE == \"cuda\" and AMP_DTYPE is not None and enabled))\n",
    "\n",
    "# ---------------- parameter-efficient modules ----------------\n",
    "class LoRMALinear(nn.Module):\n",
    "    \"\"\"Multiplicative low-rank adaptation (LoRMA-style): W' = (I + B A) W  ->  y = W x + B A (W x).\n",
    "    B is zero-initialised so the Phase-1 function is preserved at step 0.\"\"\"\n",
    "    def __init__(self, base, r=16, alpha=32, dropout=0.05):\n",
    "        super().__init__()\n",
    "        self.base = base; out = base.out_features\n",
    "        self.A = nn.Parameter(torch.empty(r, out)); nn.init.kaiming_uniform_(self.A, a=math.sqrt(5))\n",
    "        self.B = nn.Parameter(torch.zeros(out, r))\n",
    "        self.scale = alpha / r; self.drop = nn.Dropout(dropout)\n",
    "    def forward(self, x):\n",
    "        y = self.base(x)\n",
    "        return y + F.linear(F.linear(self.drop(y), self.A), self.B) * self.scale\n",
    "\n",
    "class Adapter(nn.Module):\n",
    "    def __init__(self, dim, bottleneck):\n",
    "        super().__init__()\n",
    "        self.down = nn.Linear(dim, bottleneck); self.up = nn.Linear(bottleneck, dim); self.act = nn.GELU()\n",
    "        nn.init.zeros_(self.up.weight); nn.init.zeros_(self.up.bias)\n",
    "    def forward(self, x): return self.up(self.act(self.down(x)))\n",
    "\n",
    "class AdapterWrap(nn.Module):\n",
    "    def __init__(self, inner, dim, bottleneck):\n",
    "        super().__init__()\n",
    "        self.inner = inner; self.adapter = Adapter(dim, bottleneck)\n",
    "    def forward(self, *a, **k):\n",
    "        o = self.inner(*a, **k)\n",
    "        return o + self.adapter(o)\n",
    "\n",
    "def _layers(lm, arch):\n",
    "    return lm.encoder if arch == \"enc_dec\" else lm.blocks\n",
    "\n",
    "def apply_lorma(lm, arch, r, alpha):\n",
    "    n = 0\n",
    "    for layer in _layers(lm, arch):\n",
    "        for name, mod in list(layer.named_modules()):\n",
    "            if isinstance(mod, nn.MultiheadAttention): continue    # its out_proj is read directly by torch -> leave untouched\n",
    "            for cname, child in list(mod.named_children()):\n",
    "                if isinstance(child, nn.Linear):\n",
    "                    setattr(mod, cname, LoRMALinear(child, r, alpha)); n += 1\n",
    "    return n\n",
    "\n",
    "def apply_adapters(lm, arch, dim, bottleneck):\n",
    "    n = 0\n",
    "    for layer in _layers(lm, arch):\n",
    "        for name in (\"attn\", \"self_attn\", \"ffn\"):\n",
    "            m = getattr(layer, name, None)\n",
    "            if m is None: continue\n",
    "            if name != \"ffn\" and not isinstance(m, GQAAttention): continue   # nn.MultiheadAttention returns a tuple -> skip\n",
    "            setattr(layer, name, AdapterWrap(m, dim, bottleneck)); n += 1\n",
    "    return n\n",
    "\n",
    "# ---------------- classifier on top of a Phase-1 backbone ----------------\n",
    "class LSIClassifier(nn.Module):\n",
    "    def __init__(self, lm, arch, n_labels, prior_bias=None, dropout=0.1, use_lwan=True):\n",
    "        super().__init__()\n",
    "        self.lm, self.arch, self.n_labels, self.use_lwan = lm, arch, n_labels, use_lwan\n",
    "        H = lm.cfg.hidden_size; self.H = H\n",
    "        self.norm = RMSNorm(H)\n",
    "        self.chunk_proj = nn.Sequential(nn.Linear(2 * H, H), nn.GELU(), nn.Dropout(dropout))\n",
    "        self.att_v = nn.Linear(H, H // 2); self.att_w = nn.Linear(H // 2, 1)\n",
    "        self.drop = nn.Dropout(dropout)\n",
    "        self.head = nn.Linear(2 * H, n_labels)\n",
    "        if prior_bias is not None:\n",
    "            with torch.no_grad(): self.head.bias.copy_(torch.as_tensor(prior_bias, dtype=torch.float32))\n",
    "        if use_lwan:\n",
    "            self.lw_q = nn.Parameter(torch.randn(n_labels, H) * 0.02)\n",
    "            self.lw_w = nn.Parameter(torch.randn(n_labels, H) * 0.02)\n",
    "            self.lw_b = nn.Parameter(torch.zeros(n_labels))\n",
    "\n",
    "    def encode(self, ids, pad_mask):\n",
    "        lm, arch = self.lm, self.arch; T = ids.size(1); dev = ids.device\n",
    "        if arch == \"decoder_only\":\n",
    "            x = lm.drop(lm.tok_emb(ids)); fr = rotary_freqs(T, lm.head_dim, dev)\n",
    "            for b in lm.blocks: x = b(x, fr)\n",
    "            return lm.norm_f(x)\n",
    "        if arch == \"efficient\":\n",
    "            x = lm.drop(lm.tok_emb(ids)); fr = rotary_freqs(T, lm.head_dim, dev)\n",
    "            loc = build_local_window_mask(T, lm.cfg.local_window, dev); ful = build_causal_mask(T, dev)\n",
    "            for i, b in enumerate(lm.blocks):\n",
    "                g = (i + 1) % lm.cfg.global_every == 0\n",
    "                x = b(x, fr, attn_mask=ful if g else loc)\n",
    "            return lm.norm_f(x)\n",
    "        if arch == \"chunk_recurrent\":\n",
    "            B = ids.size(0)\n",
    "            x = lm.drop(lm.tok_emb(ids)); fr = rotary_freqs(T, lm.head_dim, dev)\n",
    "            mem = lm.chunk_encoder(x.detach()); nch = mem.size(1)\n",
    "            mem = torch.cat([lm.null_mem.expand(B, -1, -1).to(mem.dtype), mem], dim=1)\n",
    "            cid = torch.arange(T, device=dev) // lm.cfg.chunk_size\n",
    "            slot = torch.arange(nch + 1, device=dev)\n",
    "            mm = slot[None, :] > cid[:, None]\n",
    "            for b in lm.blocks: x = b(x, fr, mem, mm)\n",
    "            return lm.norm_f(x)\n",
    "        if arch == \"enc_dec\":\n",
    "            x = lm._embed(ids)\n",
    "            for layer in lm.encoder: x = layer(x, key_padding_mask=pad_mask)\n",
    "            return x\n",
    "        raise ValueError(arch)\n",
    "\n",
    "    def forward(self, ids, doc_idx, slot, B, K):\n",
    "        pad = ids.eq(PAD_ID)\n",
    "        with amp(True):\n",
    "            h = self.encode(ids, pad)\n",
    "        with amp(False):\n",
    "            h = self.norm(h.float())\n",
    "            m = (~pad).unsqueeze(-1).float()\n",
    "            mean = (h * m).sum(1) / m.sum(1).clamp(min=1)\n",
    "            mx = h.masked_fill(m == 0, -1e4).max(1).values\n",
    "            cv = self.chunk_proj(torch.cat([mean, mx], -1))                       # (M, H)\n",
    "            C = cv.new_zeros(B, K, self.H); C[doc_idx, slot] = cv\n",
    "            cm = torch.zeros(B, K, dtype=torch.bool, device=ids.device); cm[doc_idx, slot] = True\n",
    "            a = self.att_w(torch.tanh(self.att_v(C))).squeeze(-1).masked_fill(~cm, -1e4).softmax(-1)\n",
    "            d_att = (a.unsqueeze(-1) * C).sum(1)\n",
    "            d_max = C.masked_fill(~cm.unsqueeze(-1), -1e4).max(1).values\n",
    "            logits = self.head(self.drop(torch.cat([d_att, d_max], -1)))\n",
    "            if self.use_lwan:\n",
    "                s = torch.einsum(\"bkh,lh->bkl\", C, self.lw_q) / math.sqrt(self.H)\n",
    "                s = s.masked_fill(~cm.unsqueeze(-1), -1e4).softmax(1)\n",
    "                ctx = torch.einsum(\"bkl,bkh->blh\", s, C)\n",
    "                logits = logits + (ctx * self.lw_w).sum(-1) + self.lw_b\n",
    "        return logits\n",
    "\n",
    "def free_unused(lm, arch):\n",
    "    if arch == \"enc_dec\" and hasattr(lm, \"decoder\"): lm.decoder = nn.ModuleList()\n",
    "    if hasattr(lm, \"lm_head\"): lm.lm_head = nn.Identity()\n",
    "\n",
    "def truncate_layers(lm, arch, n_keep):\n",
    "    layers = _layers(lm, arch); n = len(layers)\n",
    "    if n_keep >= n: return n\n",
    "    idx = sorted(set(np.linspace(0, n - 1, n_keep).round().astype(int).tolist()))\n",
    "    new = nn.ModuleList([layers[i] for i in idx])\n",
    "    if arch == \"enc_dec\": lm.encoder = new\n",
    "    else: lm.blocks = new\n",
    "    return len(new)\n",
    "\n",
    "def n_params(m, trainable_only=False):\n",
    "    seen, tot = set(), 0\n",
    "    for p in m.parameters():\n",
    "        if id(p) in seen or (trainable_only and not p.requires_grad): continue\n",
    "        seen.add(id(p)); tot += p.numel()\n",
    "    return tot\n",
    "\n",
    "PRIOR_BIAS = np.log(np.clip(Y_tr.mean(0), 1e-4, 0.5) / (1 - np.clip(Y_tr.mean(0), 1e-4, 0.5))).astype(np.float32)\n",
    "\n",
    "def build_classifier(exp):\n",
    "    \"\"\"Fresh Phase-1 backbone -> technique-specific freezing / adapters -> classifier. Returns (model, param_groups).\"\"\"\n",
    "    arch = exp[\"arch\"]\n",
    "    lm, cfg, _ = load_checkpoint(CKPTS[arch], \"cpu\")\n",
    "    free_unused(lm, arch)\n",
    "    if exp.get(\"keep_layers\"):\n",
    "        truncate_layers(lm, arch, exp[\"keep_layers\"])\n",
    "    elif exp[\"method\"] == \"kd\" and arch != \"enc_dec\":\n",
    "        truncate_layers(lm, arch, max(2, len(_layers(lm, arch)) // 2))\n",
    "    for p in lm.parameters(): p.requires_grad = False\n",
    "    H = cfg.hidden_size; method = exp[\"method\"]\n",
    "    peft_params = []\n",
    "    if method == \"lorma\":\n",
    "        k = apply_lorma(lm, arch, exp[\"r\"], exp[\"alpha\"]); print(f\"  LoRMA wrapped {k} linear layers (r={exp['r']})\")\n",
    "        peft_params = [p for n, p in lm.named_parameters() if n.endswith(\".A\") or n.endswith(\".B\")]\n",
    "    elif method == \"adapters\":\n",
    "        k = apply_adapters(lm, arch, H, exp[\"bottleneck\"]); print(f\"  adapters inserted: {k} (bottleneck {exp['bottleneck']})\")\n",
    "        peft_params = [p for n, p in lm.named_parameters() if \".adapter.\" in n]\n",
    "    for p in peft_params: p.requires_grad = True\n",
    "    model = LSIClassifier(lm, arch, L, prior_bias=PRIOR_BIAS, dropout=exp.get(\"dropout\", 0.1), use_lwan=True)\n",
    "    head_params = [p for n, p in model.named_parameters() if not n.startswith(\"lm.\")]\n",
    "    groups = [dict(params=head_params, lr=exp[\"lr_head\"], weight_decay=0.01, name=\"head\")]\n",
    "    layers = _layers(model.lm, arch)\n",
    "    if method in (\"lorma\", \"adapters\"):\n",
    "        groups.append(dict(params=peft_params, lr=exp[\"lr_peft\"], weight_decay=0.0, name=\"peft\"))\n",
    "    elif method == \"partial\":\n",
    "        nu = max(1, int(round(len(layers) * exp.get(\"unfreeze_frac\", 0.5))))\n",
    "        print(f\"  partial FT: unfreezing top {nu}/{len(layers)} layers (+ final norm), layer-wise LR decay {exp['lr_decay']}\")\n",
    "        for j in range(nu):\n",
    "            lyr = layers[len(layers) - 1 - j]\n",
    "            ps = list(lyr.parameters())\n",
    "            for p in ps: p.requires_grad = True\n",
    "            groups.append(dict(params=ps, lr=exp[\"lr_backbone\"] * (exp[\"lr_decay\"] ** j), weight_decay=0.01, name=f\"layer-{j}\"))\n",
    "        if hasattr(model.lm, \"norm_f\"):\n",
    "            ps = list(model.lm.norm_f.parameters())\n",
    "            for p in ps: p.requires_grad = True\n",
    "            groups.append(dict(params=ps, lr=exp[\"lr_backbone\"], weight_decay=0.0, name=\"norm_f\"))\n",
    "    elif method in (\"full\", \"kd\"):\n",
    "        ps = [p for p in model.lm.parameters()]\n",
    "        for p in ps: p.requires_grad = True\n",
    "        groups.append(dict(params=ps, lr=exp[\"lr_backbone\"], weight_decay=0.01, name=\"backbone\"))\n",
    "    else:\n",
    "        raise ValueError(method)\n",
    "    groups = [g for g in groups if len(g[\"params\"])]\n",
    "    for g in groups: g[\"base_lr\"] = g[\"lr\"]\n",
    "    return model, groups, cfg\n",
    "print(\"classifier ready | L =\", L)\n"
   ]
