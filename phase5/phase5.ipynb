    "## 4. Long-document representation\n",
    "Overlapping windows of `chunk_len` tokens; if a document has more than `k_infer` windows we keep the first, the last and the windows with the highest density of section/Act citations (relevance-based context selection)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4c9d8fdd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---------------- long-document representation: overlapping windows + relevance-based chunk selection ----------------\n",
    "CITE_RE = re.compile(r\"(?i)\\b(?:sections?|secs?\\.?|s\\.|articles?|art\\.|rules?|orders?)\\s*\\d+|\\b(?:act|code|ipc|crpc|cpc|constitution|ordinance|regulations?)\\b\")\n",
    "\n",
    "def select_chunks(starts, scores, k_max, strategy=\"smart\"):\n",
    "    n = len(starts)\n",
    "    if n <= k_max: return list(range(n))\n",
    "    if strategy == \"head\": return list(range(k_max))\n",
    "    if strategy == \"uniform\": return sorted(set(np.linspace(0, n - 1, k_max).round().astype(int).tolist()))\n",
    "    keep = {0, n - 1}\n",
    "    mid = sorted(range(1, n - 1), key=lambda i: -scores[i])\n",
    "    for i in mid:\n",
    "        if len(keep) >= k_max: break\n",
    "        keep.add(i)\n",
    "    return sorted(keep)\n",
    "\n",
    "def build_views(texts, chunk_len, overlap, k_max, strategy=\"smart\", desc=\"\"):\n",
    "    body = chunk_len - 1\n",
    "    stride = max(1, body - overlap)\n",
    "    views, t0 = [], time.time()\n",
    "    mc = HP[\"max_chars\"]\n",
    "    for i in range(0, len(texts), 128):\n",
    "        batch = []\n",
    "        for t in texts[i:i + 128]:\n",
    "            if len(t) > mc: t = t[: mc * 2 // 3] + \" \" + t[-(mc // 3):]\n",
    "            batch.append(t if t.strip() else \" \")\n",
    "        encs = tok.encode_batch(batch, add_special_tokens=False)\n",
    "        for t, e in zip(batch, encs):\n",
    "            ids = np.asarray(e.ids, dtype=np.uint16); offs = e.offsets; n = len(ids)\n",
    "            starts = list(range(0, n - overlap, stride)) if n > body else [0]\n",
    "            if not starts: starts = [0]\n",
    "            scores = []\n",
    "            for s in starts:\n",
    "                if n == 0: scores.append(0.0); continue\n",
    "                a = offs[s][0]; b = offs[min(s + body, n) - 1][1]\n",
    "                seg = t[a:b]\n",
    "                scores.append(len(CITE_RE.findall(seg)) / (len(seg) + 1) * 1000)\n",
    "            sel = select_chunks(starts, scores, k_max, strategy)\n",
    "            views.append([np.concatenate([[BOS_ID], ids[starts[j]:starts[j] + body]]).astype(np.uint16) for j in sel])\n",
    "        if (i // 128) % 20 == 0:\n",
    "            print(f\"  {desc} tokenized {min(i+128, len(texts))}/{len(texts)} ({time.time()-t0:.0f}s)\", flush=True)\n",
    "    return views\n",
    "\n",
    "def chunk_len_for(cfg):\n",
    "    return int(min(HP[\"chunk_len\"], cfg.max_position_embeddings))\n",
    "_VIEW_CACHE = {}\n",
    "def get_views(split, clen):\n",
    "    key = (split, clen)\n",
    "    if key not in _VIEW_CACHE:\n",
    "        texts = {\"train\": tr_txt, \"dev\": dv_txt, \"test\": te_txt}[split]\n",
    "        _VIEW_CACHE[key] = build_views(texts, clen, HP[\"overlap\"], HP[\"k_infer\"], \"smart\", desc=f\"{split}@{clen}\")\n",
    "    return _VIEW_CACHE[key]\n",
    "print(\"view builder ready (views are built lazily per chunk length and cached in memory)\")\n"
   ]
  },
