    "import torch, torch.nn as nn, torch.nn.functional as F\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "QUICK = False            # True -> tiny budgets, only to check that the notebook runs\n",
    "FORCE_RERUN = False      # True -> ignore cached results and retrain everything\n",
    "EXP5_BUDGET_MIN = 75     # training minutes for the new, stronger encoder run (exp5)\n",
    "LEX_ON = True            # whole-document lexical models (see intro for the rule caveat)\n",
    "LEX_REFIT = True         # lexical models: after early stopping, retrain on train+DEV and average test logits (uses dev labels for training)\n",
    "\n",
    "# ---- optional manual overrides (leave None for auto-discovery) ----\n",
    "DATA_DIR_OVERRIDE = None     # folder that contains Train/train.json, Train/dev.json, Test/test.json (searched recursively)\n",
    "TOKENIZER_OVERRIDE = None    # path to the Phase-1 tokenizer.json\n",
    "CKPT_OVERRIDE = {\"decoder_only\": None, \"efficient\": None, \"chunk_recurrent\": None, \"enc_dec\": None}  # paths to Phase-1 .pt files\n",
    "\n",
    "WORK = os.environ.get(\"LSI_WORK\") or (\"/kaggle/working\" if os.path.isdir(\"/kaggle/working\") else os.getcwd())\n",
    "os.makedirs(WORK, exist_ok=True); os.chdir(WORK)\n",
    "if WORK not in sys.path: sys.path.insert(0, WORK)\n",
    "OUT = os.path.join(WORK, \"lsi_artifacts\")\n",
    "for d in [\"cache\", \"submissions\", \"states\"]:\n",
    "    os.makedirs(os.path.join(OUT, d), exist_ok=True)\n",
    "SEARCH_ROOTS = []\n",
    "for p in [\"/kaggle/input\", \"/kaggle/working\", WORK, os.environ.get(\"LSI_INPUT\")]:\n",
    "    if p and os.path.isdir(p) and os.path.realpath(p) not in [os.path.realpath(x) for x in SEARCH_ROOTS]:\n",
    "        SEARCH_ROOTS.append(p)\n",
    "\n",
    "HP = dict(\n",
    "    chunk_len=512, overlap=64,          # window length (<= model max positions) and token overlap\n",
    "    k_infer=8, k_train=4,               # max chunks per doc at inference / sampled per doc during training\n",
    "    batch_docs=4, grad_acc=4,           # docs per micro-batch, accumulation steps (effective 16 docs)\n",
    "    exp_budget_min=70, n_evals=5, max_epochs=6, dev_eval_docs=1500,\n",
    "    max_chars=400_000,\n",
    "    kd_docs=15000, kd_chunks=4, kd_T=2.0, kd_alpha=0.5,\n",
    "    infer_chunks_per_batch=48,\n",
    "    pos_weight_pow=0.5, pos_weight_cap=30.0,\n",
    ")\n",
    "if QUICK:\n",
    "    HP.update(chunk_len=128, overlap=16, k_infer=3, k_train=2, batch_docs=2, grad_acc=1,\n",
    "              exp_budget_min=3, n_evals=2, max_epochs=2, dev_eval_docs=50, kd_docs=200, kd_chunks=2,\n",
    "              infer_chunks_per_batch=16)\n",
    "    EXP5_BUDGET_MIN = 3\n",
    "SEED = 42\n",
    "def set_seed(s):\n",
    "    random.seed(s); np.random.seed(s); torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n",
    "set_seed(SEED)\n",
    "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(\"QUICK\" if QUICK else \"FULL\", \"| device:\", DEVICE, \"| search roots:\", SEARCH_ROOTS)\n",
    "if DEVICE == \"cuda\":\n",
