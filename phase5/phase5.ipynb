   "source": [
    "# ---------------- losses ----------------\n",
    "POS_W = None\n",
    "def make_pos_weight():\n",
    "    pos = Y_tr.sum(0); n = Y_tr.shape[0]\n",
    "    pw = np.where(pos > 0, ((n - pos) / np.maximum(pos, 1)) ** HP[\"pos_weight_pow\"], 1.0)\n",
    "    return torch.as_tensor(np.clip(pw, 1.0, HP[\"pos_weight_cap\"]), dtype=torch.float32)\n",
    "\n",
    "def loss_bce(logits, y, pw):\n",
    "    return F.binary_cross_entropy_with_logits(logits, y, pos_weight=pw, reduction=\"none\").sum(1)\n",
    "\n",
    "def loss_asl(logits, y, pw, gamma_neg=2.0, gamma_pos=0.0, clip=0.02, eps=1e-8):\n",
    "    p = torch.sigmoid(logits)\n",
    "    pm = (p - clip).clamp(min=0)\n",
    "    lp = y * torch.log(p.clamp(min=eps)) * (1 - p) ** gamma_pos * pw\n",
    "    ln = (1 - y) * torch.log((1 - pm).clamp(min=eps)) * pm ** gamma_neg\n",
    "    return -(lp + ln).sum(1)\n",
    "\n",
    "def loss_kd(student_logits, teacher_logits, T):\n",
    "    soft = torch.sigmoid(teacher_logits / T)\n",
    "    return F.binary_cross_entropy_with_logits(student_logits / T, soft, reduction=\"none\").sum(1) * (T * T)\n",
    "\n",
    "# ---------------- metrics / thresholds ----------------\n",
    "def f1_per_label(Yb, Pb):\n",
    "    tp = (Yb & Pb).sum(0).astype(np.float64); fp = (~Yb & Pb).sum(0); fn = (Yb & ~Pb).sum(0)\n",
    "    den = 2 * tp + fp + fn\n",
    "    return np.where(den > 0, 2 * tp / np.maximum(den, 1), 0.0)\n",
    "\n",
    "def all_metrics(Y, Pb):\n",
    "    Yb = Y > 0.5; f = f1_per_label(Yb, Pb)\n",
    "    tp = (Yb & Pb).sum(); fp = (~Yb & Pb).sum(); fn = (Yb & ~Pb).sum()\n",
    "    present = Yb.sum(0) > 0\n",
    "    return dict(macro_f1=float(f.mean()), macro_f1_present=float(f[present].mean()) if present.any() else 0.0,\n",
    "                micro_f1=float(2 * tp / max(1, 2 * tp + fp + fn)),\n",
    "                subset_acc=float((Yb == Pb).all(1).mean()))\n",
    "\n",
    "GRID = np.round(np.arange(0.03, 0.91, 0.01), 3)\n",
    "def sigmoid(x): return 1.0 / (1.0 + np.exp(-np.clip(x, -30, 30)))\n",
    "\n",
    "def best_global(P, Y):\n",
    "    Yb = Y > 0.5\n",
    "    sc = np.array([f1_per_label(Yb, P >= t).mean() for t in GRID])\n",
    "    i = int(sc.argmax()); return float(GRID[i]), float(sc[i])\n",
    "\n",
    "def tune_thresholds(P, Y, alpha, min_pos=3):\n",
    "    Yb = Y > 0.5\n",
    "    Fm = np.stack([f1_per_label(Yb, P >= t) for t in GRID])          # (G, L)\n",
    "    g = float(GRID[Fm.mean(1).argmax()])\n",
    "    pad = np.pad(Fm, ((1, 1), (0, 0)), mode=\"edge\")\n",
    "    Fs = (pad[:-2] + pad[1:-1] + pad[2:]) / 3.0\n",
    "    t_l = GRID[Fs.argmax(0)]\n",
    "    t = np.where(Yb.sum(0) >= min_pos, alpha * t_l + (1 - alpha) * g, g)\n",
    "    return t.astype(np.float32), g\n",
    "\n",
    "def apply_thr(P, t, at_least_one=True):\n",
    "    Pb = P >= t[None, :]\n",
    "    if at_least_one:\n",
    "        none = ~Pb.any(1)\n",
    "        if none.any(): Pb[none, P[none].argmax(1)] = True\n",
    "    return Pb\n",
    "\n",
    "def choose_alpha(P, Y, repeats=5, seed=0):\n",
    "    rng = np.random.default_rng(seed); n = len(Y); res = {a: [] for a in (0.0, 0.25, 0.5, 0.75, 1.0)}\n",
    "    if n < 20: return 0.0, res\n",
    "    for _ in range(repeats):\n",
    "        perm = rng.permutation(n); h = n // 2\n",
    "        for a_idx, b_idx in ((perm[:h], perm[h:]), (perm[h:], perm[:h])):\n",
    "            for a in res:\n",
    "                t, _ = tune_thresholds(P[a_idx], Y[a_idx], a)\n",
    "                res[a].append(f1_per_label(Y[b_idx] > 0.5, apply_thr(P[b_idx], t)).mean())\n",
    "    mean = {a: float(np.mean(v)) for a, v in res.items()}\n",
    "    best = max(mean.items(), key=lambda kv: (round(kv[1], 4), -kv[0]))[0]\n",
    "    return best, mean\n",
    "\n",
    "def fit_temperature(logits, Y):\n",
    "    best, bt = 1e18, 1.0\n",
    "    for T in (0.5, 0.7, 0.85, 1.0, 1.2, 1.5, 2.0, 2.5, 3.0):\n",
    "        p = np.clip(sigmoid(logits / T), 1e-7, 1 - 1e-7)\n",
    "        l = -(Y * np.log(p) + (1 - Y) * np.log(1 - p)).mean()\n",
    "        if l < best: best, bt = l, T\n",
    "    return bt\n",
    "\n",
    "def finalize(P_dev, Y, P_test, label=\"\"):\n",
    "    \"\"\"Tune alpha (shrinkage) by split-half CV on dev, fit thresholds on full dev, evaluate, predict test.\"\"\"\n",
    "    g, f_g = best_global(P_dev, Y)\n",
    "    alpha, cvm = choose_alpha(P_dev, Y)\n",
    "    t, _ = tune_thresholds(P_dev, Y, alpha)\n",
    "    m_glob = all_metrics(Y, apply_thr(P_dev, np.full(L, g, np.float32), True))\n",
    "    m_glob_no1 = all_metrics(Y, P_dev >= g)\n",
    "    use_one = m_glob[\"macro_f1\"] >= m_glob_no1[\"macro_f1\"] - 1e-9\n",
    "    m_tuned = all_metrics(Y, apply_thr(P_dev, t, use_one))\n",
    "    out = dict(label=label, global_thr=g, alpha=alpha, at_least_one=bool(use_one), thresholds=t,\n",
    "               dev_global=m_glob, dev_tuned=m_tuned, cv_alpha=cvm,\n",
    "               test_pred=apply_thr(P_test, t, use_one), dev_pred=apply_thr(P_dev, t, use_one))\n",
    "    print(f\"[{label}] global thr {g:.2f} (macro-F1 {m_glob['macro_f1']:.4f}) | alpha {alpha} | tuned dev: macro {m_tuned['macro_f1']:.4f} \"\n",
    "          f\"(present-labels {m_tuned['macro_f1_present']:.4f}) micro {m_tuned['micro_f1']:.4f} subset {m_tuned['subset_acc']:.4f}\")\n",
    "    return out\n",
    "print(\"metrics ready\")\n"
   ]
