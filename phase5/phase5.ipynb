    "    npreds = [len(p[\"pred\"]) for p in fp]\n",
    "    print(f\"{nm}: validated {len(fp)} predictions | statutes/doc mean {np.mean(npreds):.2f}, min {min(npreds)}, max {max(npreds)} | dev gold mean {Y_dv.sum(1).mean():.2f}\")\n",
    "print(\"submissions:\", sorted(f for f in os.listdir(f\"{OUT}/submissions\") if f.endswith(\".zip\")))\n",
    "print(\"UPLOAD ->\", f\"{OUT}/submissions/FINAL.zip\", \"(best on dev)  or  \", f\"{OUT}/submissions/FINAL_neural_only.zip\", \"(Phase-1 models only)\")"
