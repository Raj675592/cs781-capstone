   "outputs": [],
   "source": [
    "# ---------------- batching ----------------\n",
    "def make_batch(view_list):\n",
    "    \"\"\"view_list: list (one per doc) of lists of uint16 chunk arrays -> padded tensors on DEVICE.\"\"\"\n",
    "    flat, didx, slot = [], [], []\n",
    "    for d, cl in enumerate(view_list):\n",
    "        for j, c in enumerate(cl):\n",
    "            flat.append(c); didx.append(d); slot.append(j)\n",
    "    T = max(len(c) for c in flat)\n",
    "    ids = np.full((len(flat), T), PAD_ID, dtype=np.int64)\n",
    "    for j, c in enumerate(flat): ids[j, :len(c)] = c\n",
    "    K = max(len(cl) for cl in view_list)\n",
    "    return (torch.from_numpy(ids).to(DEVICE), torch.tensor(didx, device=DEVICE), torch.tensor(slot, device=DEVICE),\n",
    "            len(view_list), K)\n",
    "\n",
    "def sample_train_chunks(cl, k, rng):\n",
    "    if len(cl) <= k: return cl\n",
    "    sel = sorted(rng.choice(len(cl), size=k, replace=False).tolist())\n",
    "    return [cl[i] for i in sel]\n",
    "\n",
    "@torch.no_grad()\n",
    "def predict_logits(model, views, desc=\"\"):\n",
    "    model.eval(); n = len(views); out = np.zeros((n, L), dtype=np.float32)\n",
    "    order = np.argsort([-len(v) for v in views], kind=\"stable\")\n",
    "    batches, cur, cnt = [], [], 0\n",
    "    for i in order:\n",
    "        if cur and cnt + len(views[i]) > HP[\"infer_chunks_per_batch\"]:\n",
    "            batches.append(cur); cur, cnt = [], 0\n",
    "        cur.append(int(i)); cnt += len(views[i])\n",
    "    if cur: batches.append(cur)\n",
    "    t0 = time.time()\n",
    "    for bi, b in enumerate(batches):\n",
    "        ids, didx, slot, B, K = make_batch([views[i] for i in b])\n",
    "        out[b] = model(ids, didx, slot, B, K).float().cpu().numpy()\n",
    "    return out\n",
    "\n",
    "def trainable_state(model):\n",
    "    names = {n for n, p in model.named_parameters() if p.requires_grad}\n",
    "    return {k: v.detach().cpu().clone() for k, v in model.state_dict().items() if k in names}\n",
    "\n",
    "def save_state(model, path): torch.save(trainable_state(model), path)\n",
    "def load_state(model, path):\n",
    "    sd = torch.load(path, map_location=\"cpu\")\n",
    "    miss = model.load_state_dict(sd, strict=False)\n",
    "    return len(sd)\n",
    "\n",
    "# ---------------- training ----------------\n",
    "def lr_mult(step, total, warm):\n",
    "    if step < warm: return (step + 1) / warm\n",
    "    prog = min(1.0, (step - warm) / max(1, total - warm))\n",
    "    return 0.1 + 0.9 * 0.5 * (1 + math.cos(math.pi * prog))\n",
    "\n",
    "def ema_init(model):\n",
    "    return {n: p.detach().clone().float() for n, p in model.named_parameters() if p.requires_grad}\n",
    "@torch.no_grad()\n",
    "def ema_update(ema, model, d):\n",
    "    for n, p in model.named_parameters():\n",
    "        e = ema.get(n)\n",
    "        if e is not None: e.mul_(d).add_(p.detach().float(), alpha=1 - d)\n",
    "@torch.no_grad()\n",
    "def ema_swap(ema, model):          # calling it twice restores the original weights\n",
    "    for n, p in model.named_parameters():\n",
    "        e = ema.get(n)\n",
    "        if e is not None:\n",
    "            tmp = p.detach().clone(); p.copy_(e.to(p.dtype)); e.copy_(tmp.float())\n",
    "\n",
    "def train_model(model, groups, exp, views_tr, dev_views_eval, Y_dev_eval, kd=None):\n",
    "    \"\"\"kd = (teacher_logits[N,L] float32 with NaN rows for docs without teacher, T, alpha) or None.\n",
    "    Optional exp keys: budget_min, k_train, ema (decay), seed.\"\"\"\n",
    "    model.to(DEVICE); model.train()\n",
    "    opt = torch.optim.AdamW([{k: v for k, v in g.items() if k != \"name\"} for g in groups], betas=(0.9, 0.98))\n",
    "    use_scaler = (DEVICE == \"cuda\" and AMP_DTYPE == torch.float16)\n",
    "    scaler = torch.amp.GradScaler(\"cuda\", enabled=use_scaler)\n",
    "    pw = make_pos_weight().to(DEVICE)\n",
    "    crit = loss_asl if exp[\"loss\"] == \"asl\" else loss_bce\n",
    "    seed = exp.get(\"seed\", SEED); rng = np.random.default_rng(seed)\n",
    "    k_train = exp.get(\"k_train\", HP[\"k_train\"])\n",
    "    N = len(views_tr); B, ACC = HP[\"batch_docs\"], HP[\"grad_acc\"]\n",
    "    steps_per_epoch = max(1, math.ceil(N / (B * ACC)))\n",
    "    total_target = max(4, exp.get(\"epochs\", HP[\"max_epochs\"]) * steps_per_epoch)\n",
    "    total = total_target\n",
    "    budget_min = exp.get(\"budget_min\", HP[\"exp_budget_min\"]); budget_s = budget_min * 60\n",
    "    warm = max(2, int(0.05 * total))\n",
    "    perm, ptr = rng.permutation(N), 0\n",
    "    best, best_state, hist = -1.0, None, []\n",
    "    t0 = time.time(); step = 0; eval_every = max(1, total // HP[\"n_evals\"]); probed = set()\n",
    "    if DEVICE == \"cuda\": torch.cuda.reset_peak_memory_stats()\n",
    "    teacher, kdT, kdA = (kd if kd is not None else (None, 1.0, 0.0))\n",
    "    params_all = [p for g in groups for p in g[\"params\"]]\n",
    "    ema_d = exp.get(\"ema\", 0.0)\n",
    "    ema = ema_init(model) if ema_d else None\n",
    "\n",
    "    def do_eval(tag):\n",
    "        nonlocal best, best_state\n",
    "        te = time.time()\n",
    "        if ema is not None: ema_swap(ema, model)          # evaluate (and keep) the EMA weights\n",
    "        lg = predict_logits(model, dev_views_eval)\n",
    "        g, f = best_global(sigmoid(lg), Y_dev_eval)\n",
    "        if f > best:\n",
    "            best = f; best_state = trainable_state(model)\n",
    "        if ema is not None: ema_swap(ema, model)\n",
    "        model.train()\n",
    "        hist.append(dict(step=step, dev_macro_f1=f, thr=g, minutes=(time.time() - t0) / 60))\n",
    "        print(f\"  [eval {tag}{' EMA' if ema is not None else ''}] step {step}/{total} | dev macro-F1 {f:.4f} @thr {g:.2f} | {(time.time()-t0)/60:.1f} min (eval {time.time()-te:.0f}s)\", flush=True)\n",
    "\n",
    "    while step < total:\n",
    "        try:\n",
    "            opt.zero_grad(set_to_none=True)\n",
    "            tot_loss = 0.0\n",
    "            for _ in range(ACC):\n",
    "                if ptr + B > N: perm, ptr = rng.permutation(N), 0\n",
    "                idx = perm[ptr:ptr + B]; ptr += B\n",
    "                vl = [sample_train_chunks(views_tr[i], k_train, rng) for i in idx]\n",
    "                ids, didx, slot, nb, K = make_batch(vl)\n",
    "                y = torch.as_tensor(Y_tr[idx], device=DEVICE)\n",
    "                logits = model(ids, didx, slot, nb, K).float()\n",
    "                loss = crit(logits, y, pw)\n",
    "                if teacher is not None:\n",
    "                    tz = torch.as_tensor(teacher[idx], device=DEVICE)\n",
    "                    has = ~torch.isnan(tz).any(1)\n",
    "                    if has.any():\n",
    "                        lk = loss_kd(logits[has], tz[has], kdT)\n",
    "                        loss = loss.clone(); loss[has] = (1 - kdA) * loss[has] + kdA * lk\n",
    "                loss = loss.mean() / ACC\n",
    "                scaler.scale(loss).backward(); tot_loss += loss.item()\n",
    "            scaler.unscale_(opt)\n",
    "            torch.nn.utils.clip_grad_norm_(params_all, 1.0)\n",
    "            m = lr_mult(step, total, warm)\n",
    "            for g in opt.param_groups: g[\"lr\"] = g[\"base_lr\"] * m\n",
    "            scaler.step(opt); scaler.update()\n",
    "        except torch.cuda.OutOfMemoryError:\n",
    "            print(\"  [OOM] halving micro-batch\", flush=True)\n",
    "            opt.zero_grad(set_to_none=True); gc.collect(); torch.cuda.empty_cache()\n",
    "            if B == 1: raise\n",
    "            B = max(1, B // 2); ACC = ACC * 2; continue\n",
    "        step += 1\n",
    "        if ema is not None: ema_update(ema, model, min(ema_d, (1 + step) / (10 + step)))\n",
    "        if not math.isfinite(tot_loss): raise RuntimeError(\"loss is NaN/inf - lower the learning rate\")\n",
    "        if step % 50 == 0 or step == 1:\n",
    "            print(f\"  step {step}/{total} | loss {tot_loss:.4f} | {(time.time()-t0)/60:.1f} min\", flush=True)\n",
    "        # adapt the number of steps to the wall-clock budget (after a few steps we know the speed)\n",
    "        for probe in (max(3, min(10, total // 10)), max(6, min(40, total // 3))):\n",
    "            if step == probe and probe not in probed:\n",
    "                probed.add(probe)\n",
    "                sps = (time.time() - t0) / step\n",
    "                est = int(budget_s * 0.80 / max(sps, 1e-6))\n",
    "                if est < total:\n",
    "                    total = max(step + 2, est); warm = max(2, int(0.05 * total)); eval_every = max(1, total // HP[\"n_evals\"])\n",
    "                    print(f\"  budget {budget_min} min @ {sps:.2f}s/step -> total steps reduced to {total} (target was {total_target})\", flush=True)\n",
    "        if step % eval_every == 0 and step < total: do_eval(\"periodic\")\n",
    "        if time.time() - t0 > budget_s * 1.1:\n",
    "            print(\"  time budget exhausted -> stopping\", flush=True); break\n",
    "    do_eval(\"final\")\n",
    "    if best_state is not None: model.load_state_dict(best_state, strict=False)\n",
    "    info = dict(steps=step, minutes=(time.time() - t0) / 60, best_dev_macro_f1=best, history=hist,\n",
    "                peak_mem_gb=(torch.cuda.max_memory_allocated() / 1e9 if DEVICE == \"cuda\" else 0.0), total_steps_target=total_target)\n",
    "    return info\n",
    "print(\"engine ready\")\n"
   ]
  },
