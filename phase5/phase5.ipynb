   "source": [
    "### Experiments 6-7 — whole-document lexical \"wide\" models (`lexical_wide`, `lexical_wide_b`)\n",
    "Hashed 1-3-grams of Phase-1 tokenizer tokens over (almost) the entire document, sublinear TF × IDF, L2-normalised, rare n-grams (train df < 3) dropped → `EmbeddingBag` → LayerNorm → MLP + linear skip → 100 logits. Trained from scratch on the competition train set, early-stopped on dev. Set `LEX_ON = False` to skip (e.g. if your instructor says only Phase-1 models may be used)."
   ]
  },
  {
   "cell_type": "code",
   "id": "255abba1",
   "metadata": {},
   "source": [
    "LEXCFG = dict(buckets=1 << 20, max_tok=16000, min_df=3, epochs=12, bs=64, patience=3)\n",
    "if QUICK: LEXCFG.update(buckets=1 << 16, max_tok=2000, epochs=2, bs=32)\n",
    "LEX_MODELS = [\n",
    "    dict(name=\"lexical_wide\",   D=192, drop=0.3, fdrop=0.15, lr=1e-3, lr_emb=4e-3, seed=11),\n",
    "    dict(name=\"lexical_wide_b\", D=256, drop=0.4, fdrop=0.25, lr=1e-3, lr_emb=3e-3, seed=22),\n",
    "    dict(name=\"lexical_wide_c\", D=320, drop=0.5, fdrop=0.35, lr=8e-4, lr_emb=3e-3, seed=33),\n",
    "]\n",
    "B_ = LEXCFG[\"buckets\"]\n",
    "\n",
    "def _hash_ngrams(ids):\n",
    "    a = ids.astype(np.int64); h = [a % B_]\n",
    "    if len(a) >= 2: h.append(((a[:-1] * 1000003) ^ (a[1:] * 2654435761 + 12345)) % B_)\n",
    "    if len(a) >= 3: h.append(((a[:-2] * 73856093) ^ (a[1:-1] * 19349663) ^ (a[2:] * 83492791)) % B_)\n",
    "    return np.concatenate(h)\n",
    "\n",
    "def lex_counts(texts, desc=\"\"):\n",
    "    mc, mt, out, t0 = HP[\"max_chars\"], LEXCFG[\"max_tok\"], [], time.time()\n",
    "    for i in range(0, len(texts), 256):\n",
    "        batch = []\n",
    "        for t in texts[i:i + 256]:\n",
    "            if len(t) > mc: t = t[: mc * 2 // 3] + \" \" + t[-(mc // 3):]\n",
    "            batch.append(t if t.strip() else \" \")\n",
    "        for e in tok.encode_batch(batch, add_special_tokens=False):\n",
    "            ids = np.asarray(e.ids, dtype=np.int64)\n",
    "            if len(ids) > mt: ids = np.concatenate([ids[: mt * 5 // 8], ids[-(mt * 3 // 8):]])\n",
    "            u, c = np.unique(_hash_ngrams(ids), return_counts=True)\n",
    "            out.append((u.astype(np.int32), c.astype(np.float32)))\n",
    "        if (i // 256) % 40 == 0: print(f\"  lexical {desc} {min(i+256, len(texts))}/{len(texts)} ({time.time()-t0:.0f}s)\", flush=True)\n",
    "    return out\n",
    "\n",
    "def lex_features():\n",
    "    ctr, cdv, cte = lex_counts(tr_txt, \"train\"), lex_counts(dv_txt, \"dev\"), lex_counts(te_txt, \"test\")\n",
    "    df = np.zeros(B_, np.int32)\n",
    "    for u, _ in ctr: df[u] += 1\n",
    "    idf = (np.log((1.0 + len(ctr)) / (1.0 + df)) + 1.0).astype(np.float32)\n",
    "    keep = df >= LEXCFG[\"min_df\"]\n",
    "    print(f\"  buckets kept: {int(keep.sum())}/{B_}\")\n",
    "    def to_csr(counts):\n",
    "        ind, dat, lens = [], [], []\n",
    "        for u, c in counts:\n",
    "            m = keep[u]; u = u[m]; w = ((1.0 + np.log(c[m])) * idf[u]).astype(np.float32)\n",
    "            nrm = float(np.sqrt((w * w).sum()))\n",
    "            if nrm > 0: w = w / nrm\n",
    "            ind.append(u); dat.append(w); lens.append(len(u))\n",
    "        ip = np.zeros(len(lens) + 1, np.int64); ip[1:] = np.cumsum(lens)\n",
    "        return dict(indptr=ip, indices=np.concatenate(ind), data=np.concatenate(dat))\n",
    "    X = to_csr(ctr), to_csr(cdv), to_csr(cte)\n",
    "    print(f\"  nnz/doc train: {X[0]['indptr'][-1] / max(1, len(ctr)):.0f}\")\n",
    "    return X\n",
    "\n",
    "class LexWide(nn.Module):\n",
    "    def __init__(self, D, L, prior, drop):\n",
    "        super().__init__()\n",
    "        self.emb = nn.EmbeddingBag(B_, D, mode=\"sum\", sparse=True); nn.init.normal_(self.emb.weight, std=0.1)\n",
    "        self.norm = nn.LayerNorm(D); self.drop = nn.Dropout(drop)\n",
    "        self.mlp = nn.Sequential(nn.Linear(D, 2 * D), nn.GELU(), nn.Dropout(drop), nn.Linear(2 * D, L))\n",
    "        self.skip = nn.Linear(D, L)\n",
    "        with torch.no_grad(): self.skip.bias.copy_(torch.as_tensor(prior, dtype=torch.float32))\n",
    "    def forward(self, idx, off, w):\n",
    "        h = self.drop(self.norm(self.emb(idx, off, per_sample_weights=w)))\n",
    "        return self.mlp(h) + self.skip(h)\n",
    "\n",
    "def lex_batch(X, rows, rng=None, fdrop=0.0):\n",
    "    ip, ind, dat = X[\"indptr\"], X[\"indices\"], X[\"data\"]\n",
    "    si = [ind[ip[r]:ip[r + 1]] for r in rows]; sw = [dat[ip[r]:ip[r + 1]] for r in rows]\n",
    "    lens = np.array([len(s) for s in si])\n",
    "    idx = np.concatenate(si).astype(np.int64); w = np.concatenate(sw).astype(np.float32)\n",
    "    if fdrop > 0 and rng is not None: w = w * (rng.random(len(w)) > fdrop) / (1.0 - fdrop)\n",
    "    off = np.concatenate([[0], np.cumsum(lens)[:-1]]).astype(np.int64)\n",
    "    return (torch.from_numpy(idx).to(DEVICE), torch.from_numpy(off).to(DEVICE), torch.from_numpy(w.astype(np.float32)).to(DEVICE))\n",
    "\n",
    "@torch.no_grad()\n",
    "def lex_predict(model, X, n):\n",
    "    model.eval(); out = np.zeros((n, L), np.float32)\n",
    "    for i in range(0, n, 256):\n",
    "        rows = np.arange(i, min(n, i + 256)); out[rows] = model(*lex_batch(X, rows)).float().cpu().numpy()\n",
    "    return out\n",
    "\n",
    "def cat_csr(A, B):\n",
    "    return dict(indptr=np.concatenate([A[\"indptr\"], B[\"indptr\"][1:] + A[\"indptr\"][-1]]),\n",
    "                indices=np.concatenate([A[\"indices\"], B[\"indices\"]]), data=np.concatenate([A[\"data\"], B[\"data\"]]))\n",
    "\n",
    "def refit_lex(cfg, Xtr, Xdv, Xte, epochs):\n",
    "    X = cat_csr(Xtr, Xdv); Y = np.concatenate([Y_tr, Y_dv]).astype(np.float32)\n",
    "    set_seed(cfg[\"seed\"] + 100); rng = np.random.default_rng(cfg[\"seed\"] + 100); t0 = time.time()\n",
    "    model = LexWide(cfg[\"D\"], L, PRIOR_BIAS, cfg[\"drop\"]).to(DEVICE)\n",
    "    opt_s = torch.optim.SparseAdam(list(model.emb.parameters()), lr=cfg[\"lr_emb\"])\n",
    "    opt_d = torch.optim.AdamW([p for n, p in model.named_parameters() if not n.startswith(\"emb.\")], lr=cfg[\"lr\"], weight_decay=0.01)\n",
    "    pw = make_pos_weight().to(DEVICE)\n",
    "    N = len(X[\"indptr\"]) - 1; bs = LEXCFG[\"bs\"]; spe = math.ceil(N / bs); total = epochs * spe; step = 0\n",
    "    for ep in range(epochs):\n",
    "        model.train(); perm = rng.permutation(N)\n",
    "        for s in range(spe):\n",
    "            rows = perm[s * bs:(s + 1) * bs]\n",
    "            mlt = 0.05 + 0.95 * 0.5 * (1 + math.cos(math.pi * step / total)); step += 1\n",
    "            for o, base in ((opt_s, cfg[\"lr_emb\"]), (opt_d, cfg[\"lr\"])):\n",
    "                for g in o.param_groups: g[\"lr\"] = base * mlt\n",
    "            logits = model(*lex_batch(X, rows, rng, cfg[\"fdrop\"]))\n",
    "            loss = loss_bce(logits, torch.as_tensor(Y[rows], device=DEVICE), pw).mean()\n",
    "            opt_s.zero_grad(); opt_d.zero_grad(); loss.backward(); opt_s.step(); opt_d.step()\n",
    "    out = lex_predict(model, Xte, len(Xte[\"indptr\"]) - 1)\n",
    "    del model, opt_s, opt_d; gc.collect()\n",
    "    if DEVICE == \"cuda\": torch.cuda.empty_cache()\n",
    "    print(f\"  refit done in {(time.time()-t0)/60:.1f} min\", flush=True)\n",
    "    return out\n",
    "\n",
    "def train_lex(cfg, Xtr, Xdv, Xte):\n",
    "    set_seed(cfg[\"seed\"]); rng = np.random.default_rng(cfg[\"seed\"]); t0 = time.time()\n",
    "    model = LexWide(cfg[\"D\"], L, PRIOR_BIAS, cfg[\"drop\"]).to(DEVICE)\n",
    "    opt_s = torch.optim.SparseAdam(list(model.emb.parameters()), lr=cfg[\"lr_emb\"])\n",
    "    opt_d = torch.optim.AdamW([p for n, p in model.named_parameters() if not n.startswith(\"emb.\")], lr=cfg[\"lr\"], weight_decay=0.01)\n",
    "    pw = make_pos_weight().to(DEVICE)\n",
    "    N = len(Xtr[\"indptr\"]) - 1; bs = LEXCFG[\"bs\"]; spe = math.ceil(N / bs); total = LEXCFG[\"epochs\"] * spe; step = 0\n",
    "    best, best_state, bad, ndv = -1.0, None, 0, len(Xdv[\"indptr\"]) - 1; best_ep = 1\n",
    "    for ep in range(LEXCFG[\"epochs\"]):\n",
    "        model.train(); perm = rng.permutation(N); tl = 0.0\n",
    "        for s in range(spe):\n",
    "            rows = perm[s * bs:(s + 1) * bs]\n",
    "            mlt = 0.05 + 0.95 * 0.5 * (1 + math.cos(math.pi * step / total)); step += 1\n",
    "            for o, base in ((opt_s, cfg[\"lr_emb\"]), (opt_d, cfg[\"lr\"])):\n",
    "                for g in o.param_groups: g[\"lr\"] = base * mlt\n",
    "            logits = model(*lex_batch(Xtr, rows, rng, cfg[\"fdrop\"]))\n",
    "            loss = loss_bce(logits, torch.as_tensor(Y_tr[rows], device=DEVICE), pw).mean()\n",
    "            opt_s.zero_grad(); opt_d.zero_grad(); loss.backward(); opt_s.step(); opt_d.step(); tl += loss.item()\n",
    "        lg = lex_predict(model, Xdv, ndv); g, f = best_global(sigmoid(lg), Y_dv)\n",
    "        print(f\"  [{cfg['name']}] epoch {ep+1}/{LEXCFG['epochs']} | train loss {tl/spe:.2f} | dev macro-F1 {f:.4f} @thr {g:.2f} | {(time.time()-t0)/60:.1f} min\", flush=True)\n",
    "        if f > best: best, bad, best_ep = f, 0, ep + 1; best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n",
    "        else:\n",
    "            bad += 1\n",
    "            if bad >= LEXCFG[\"patience\"]: print(\"  early stop\"); break\n",
    "    model.load_state_dict(best_state)\n",
    "    t1 = time.time(); dev_lg = lex_predict(model, Xdv, ndv); t_dev = time.time() - t1\n",
    "    te_lg = lex_predict(model, Xte, len(Xte[\"indptr\"]) - 1)\n",
    "    del model, opt_s, opt_d; gc.collect()\n",
    "    if DEVICE == \"cuda\": torch.cuda.empty_cache()\n",
    "    refit = False\n",
    "    if LEX_REFIT and best_ep >= 2:\n",
    "        try:\n",
    "            te2 = refit_lex(cfg, Xtr, Xdv, Xte, best_ep)\n",
    "            te_lg = 0.5 * (te_lg + te2); refit = True\n",
    "            print(f\"  [{cfg['name']}] refit on train+dev for {best_ep} epochs -> test logits averaged\", flush=True)\n",
    "        except Exception:\n",
    "            print(\"  refit failed, using train-only model:\\n\" + traceback.format_exc()); gc.collect()\n",
    "            if DEVICE == \"cuda\": torch.cuda.empty_cache()\n",
    "    info = dict(name=cfg[\"name\"], arch=\"lexical\", refit_train_dev=refit, technique=\"Hashed 1-3-gram TF-IDF wide model (whole document)\",\n",
    "                params_M=(B_ * cfg[\"D\"]) / 1e6, trainable_M=(B_ * cfg[\"D\"]) / 1e6, steps=step, minutes=(time.time() - t0) / 60,\n",
    "                best_dev_macro_f1=best, infer_docs_per_s=ndv / max(t_dev, 1e-6),\n",
    "                peak_mem_gb=(torch.cuda.max_memory_allocated() / 1e9 if DEVICE == \"cuda\" else 0.0))\n",
    "    return dev_lg, te_lg, info\n",
    "\n",
    "def run_lexical():\n",
    "    FEAT = None\n",
    "    for cfg in LEX_MODELS:\n",
    "        name = cfg[\"name\"]; P = _paths(name)\n",
    "        print(\"\\n\" + \"=\" * 100 + f\"\\n{name} | lexical wide model\\n\" + \"=\" * 100, flush=True)\n",
    "        try:\n",
    "            if os.path.exists(P[\"npz\"]) and os.path.exists(P[\"info\"]) and not FORCE_RERUN:\n",
    "                d = np.load(P[\"npz\"]); RESULTS[name] = dict(dev=d[\"dev\"], test=d[\"test\"], info=json.load(open(P[\"info\"]))); print(\"  cached -> skipped\"); continue\n",
    "            if FEAT is None: FEAT = lex_features()\n",
    "            dev_lg, te_lg, info = train_lex(cfg, *FEAT)\n",
    "            np.savez_compressed(P[\"npz\"], dev=dev_lg, test=te_lg); json.dump(info, open(P[\"info\"], \"w\"), default=float)\n",
    "            RESULTS[name] = dict(dev=dev_lg, test=te_lg, info=info)\n",
    "            g, f = best_global(sigmoid(dev_lg), Y_dv); print(f\"  FULL dev macro-F1 (global thr {g:.2f}): {f:.4f}\")\n",
    "        except Exception:\n",
    "            print(f\"\\n!!! {name} FAILED - continuing. Traceback:\\n\" + traceback.format_exc()); gc.collect()\n",
    "            if DEVICE == \"cuda\": torch.cuda.empty_cache()\n",
    "\n",
    "if LEX_ON: run_lexical()\n",
    "else: print(\"LEX_ON = False -> lexical models skipped\")"
   ],
