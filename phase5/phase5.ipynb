   "source": [
    "from config import ModelConfig\n",
    "from models import (build_model, load_checkpoint, get_amp_dtype, RMSNorm, GQAAttention, rotary_freqs,\n",
    "                    build_local_window_mask, build_causal_mask)\n",
    "\n",
    "ALL_FILES, _seen = [], set()\n",
    "def _walk(roots):\n",
    "    for r in roots:\n",
    "        for dp, dn, fn in os.walk(r):\n",
    "            if os.path.realpath(dp).startswith(os.path.realpath(OUT)):\n",
    "                dn[:] = []; continue\n",
    "            for f in fn:\n",
    "                p = os.path.join(dp, f); rp = os.path.realpath(p)\n",
    "                if rp not in _seen:\n",
    "                    _seen.add(rp); ALL_FILES.append(p)\n",
    "_walk(SEARCH_ROOTS if not DATA_DIR_OVERRIDE else SEARCH_ROOTS + [DATA_DIR_OVERRIDE])\n",
    "print(\"files visible:\", len(ALL_FILES))\n",
    "\n",
    "# ---------------- Phase-5 data ----------------\n",
    "def _bn(p): return os.path.basename(p).lower()\n",
    "def find_data():\n",
    "    files = ALL_FILES\n",
    "    if DATA_DIR_OVERRIDE:\n",
    "        files = [p for p in ALL_FILES if os.path.realpath(p).startswith(os.path.realpath(DATA_DIR_OVERRIDE))]\n",
    "    cands = [(p, os.path.join(os.path.dirname(p), \"dev.json\")) for p in files\n",
    "             if _bn(p) == \"train.json\" and os.path.exists(os.path.join(os.path.dirname(p), \"dev.json\"))]\n",
    "    assert cands, \"train.json + dev.json not found under the input folders (set DATA_DIR_OVERRIDE)\"\n",
    "    def sc(pair):\n",
    "        s = pair[0].lower()\n",
    "        return sum(k in s for k in [\"lsi\", \"phase_5\", \"phase5\", \"phase-5\"])\n",
    "    cands.sort(key=sc, reverse=True)\n",
    "    tr, dv = cands[0]\n",
    "    tests = [p for p in files if _bn(p) == \"test.json\"]\n",
    "    assert tests, \"test.json not found (set DATA_DIR_OVERRIDE)\"\n",
    "    def common(p):\n",
    "        a, b = os.path.dirname(tr).split(os.sep), os.path.dirname(p).split(os.sep)\n",
    "        n = 0\n",
    "        for x, y in zip(a, b):\n",
    "            if x != y: break\n",
    "            n += 1\n",
    "        return (n, \"phase_1\" not in p.lower())\n",
    "    tests.sort(key=common, reverse=True)\n",
    "    return tr, dv, tests[0]\n",
    "TRAIN_FILE, DEV_FILE, TEST_FILE = find_data()\n",
    "print(\"train:\", TRAIN_FILE, \"\\ndev  :\", DEV_FILE, \"\\ntest :\", TEST_FILE)\n",
    "\n",
    "# ---------------- tokenizer ----------------\n",
    "def find_tokenizer():\n",
    "    if TOKENIZER_OVERRIDE: return TOKENIZER_OVERRIDE\n",
    "    c = [p for p in ALL_FILES if _bn(p) == \"tokenizer.json\"]\n",
    "    assert c, \"Phase-1 tokenizer.json not found (set TOKENIZER_OVERRIDE)\"\n",
    "    c.sort(key=lambda p: (\"artifacts\" in p.lower(), os.path.getsize(p)), reverse=True)\n",
    "    return c[0]\n",
    "TOK_PATH = find_tokenizer()\n",
    "tok = Tokenizer.from_file(TOK_PATH)\n",
    "PAD_ID, BOS_ID, EOS_ID = (tok.token_to_id(t) for t in (\"<pad>\", \"<bos>\", \"<eos>\"))\n",
    "assert None not in (PAD_ID, BOS_ID, EOS_ID), \"tokenizer is not the Phase-1 tokenizer (missing <pad>/<bos>/<eos>)\"\n",
    "print(\"tokenizer:\", TOK_PATH, \"| vocab\", tok.get_vocab_size())\n",
    "\n",
    "# ---------------- Phase-1 checkpoints ----------------\n",
    "ARCHS = [\"decoder_only\", \"efficient\", \"chunk_recurrent\", \"enc_dec\"]\n",
    "def _peek_arch(path):\n",
    "    try:\n",
    "        ck = torch.load(path, map_location=\"cpu\", weights_only=False)\n",
    "        cfg = ck.get(\"config\")\n",
    "        a = cfg.get(\"architecture\") if isinstance(cfg, dict) else getattr(cfg, \"architecture\", None)\n",
    "        del ck; gc.collect()\n",
    "        return a\n",
    "    except Exception as e:\n",
    "        return None\n",
    "def find_ckpts():\n",
    "    pts = [p for p in ALL_FILES if p.endswith(\".pt\") and not any(s in p.lower() for s in\n",
    "           [\"_step\", \"optim\", \"smoke\", \"distill\", \"student\", \"lsi_artifacts\"])]\n",
    "    found = {}\n",
    "    for a in ARCHS:\n",
    "        if CKPT_OVERRIDE.get(a):\n",
    "            found[a] = CKPT_OVERRIDE[a]; continue\n",
    "        cand = [p for p in pts if a in _bn(p)]\n",
    "        cand.sort(key=lambda p: (\"tier2\" in p.lower(), \"tier1\" in p.lower(), \"_best\" in _bn(p), os.path.getsize(p)), reverse=True)\n",
    "        for p in cand:\n",
    "            if _peek_arch(p) == a:\n",
    "                found[a] = p; break\n",
    "    missing = [a for a in ARCHS if a not in found]\n",
    "    if missing:   # fall back to peeking every remaining .pt\n",
    "        used = set(found.values())\n",
    "        for p in sorted(pts, key=os.path.getsize, reverse=True):\n",
    "            if p in used: continue\n",
    "            a = _peek_arch(p)\n",
    "            if a in missing and a not in found:\n",
    "                found[a] = p\n",
    "    return found\n",
    "CKPTS = find_ckpts()\n",
    "for a in ARCHS:\n",
    "    print(f\"{a:16s} ->\", CKPTS.get(a, \"NOT FOUND\"))\n",
    "assert CKPTS, \"no Phase-1 checkpoints found (set CKPT_OVERRIDE)\"\n",
    "\n",
    "\n",
    "# ---------------- restore cached results of the previous run (attached as an input dataset) ----------------\n",
    "def restore_cache():\n",
    "    n = 0; seen = []\n",
    "    for p in ALL_FILES:\n",
    "        if os.path.realpath(p).startswith(os.path.realpath(OUT)): continue\n",
    "        parts = p.replace(\"\\\\\", \"/\").split(\"/\")\n",
    "        b = parts[-1]; par = parts[-2] if len(parts) > 1 else \"\"\n",
    "        if par == \"cache\" and b.startswith((\"exp\", \"lexical\")) and b.endswith((\".npz\", \".json\")):\n",
    "            dst = f\"{OUT}/cache/{b}\"\n",
    "            if not os.path.exists(dst):\n",
    "                shutil.copy(p, dst); n += 1; seen.append(b)\n",
    "    print(f\"restored {n} cached files:\", sorted(seen))\n",
    "    if n == 0 and not any(f.endswith(\".npz\") for f in os.listdir(f\"{OUT}/cache\")):\n",
    "        print(\"NOTE: no cache found -> exp1-4 will be retrained (slow). Attach the previous run's output as an input to reuse it.\")\n",
    "if not FORCE_RERUN: restore_cache()\n"
   ]
