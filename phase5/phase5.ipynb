    "## 9. Calibration, thresholds, ensembles\n",
    "All members (neural + lexical) are temperature-calibrated; greedy / mean ensembles are built over *all* members and over the *neural-only* members. `FINAL` = best on dev, `FINAL_neural_only` = best without lexical members."
   ]
  },
  {
   "cell_type": "code",
   "id": "d7253cec",
   "metadata": {},
   "source": [
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "avail = [n for n in RESULTS]\n",
    "assert avail, \"no experiment finished - see the tracebacks above\"\n",
    "neural = [n for n in avail if not n.startswith(\"lexical\")]\n",
    "print(\"members:\", avail, \"| neural-only:\", neural)\n",
    "\n",
    "# ---- calibration (temperature) per member ----\n",
    "CAL, SINGLE = {}, {}\n",
    "for n in avail:\n",
    "    T = fit_temperature(RESULTS[n][\"dev\"], Y_dv)\n",
    "    CAL[n] = dict(T=T, dev=sigmoid(RESULTS[n][\"dev\"] / T), test=sigmoid(RESULTS[n][\"test\"] / T))\n",
    "    SINGLE[n] = finalize(CAL[n][\"dev\"], Y_dv, CAL[n][\"test\"], label=n)\n",
    "    SINGLE[n][\"T\"] = T; SINGLE[n][\"members\"] = [n]; SINGLE[n][\"_pd\"] = CAL[n][\"dev\"]; SINGLE[n][\"_pt\"] = CAL[n][\"test\"]\n",
    "\n",
    "def greedy_ensemble(Ps, Y, iters=15):\n",
    "    sel, cur = [], None\n",
    "    for _ in range(iters):\n",
    "        best = None\n",
    "        for n in Ps:\n",
    "            cand = Ps[n] if cur is None else (cur * len(sel) + Ps[n]) / (len(sel) + 1)\n",
    "            sc = best_global(cand, Y)[1]\n",
    "            if best is None or sc > best[0]: best = (sc, n, cand)\n",
    "        sel.append(best[1]); cur = best[2]\n",
    "    return sel\n",
    "\n",
    "def make_ens(names, kind, label):\n",
    "    if len(names) == 1: r = dict(SINGLE[names[0]]); r[\"label\"] = label; return r\n",
    "    if kind == \"mean\": W = {n: 1.0 / len(names) for n in names}\n",
    "    else:\n",
    "        sel = greedy_ensemble({n: CAL[n][\"dev\"] for n in names}, Y_dv); W = {n: sel.count(n) / len(sel) for n in names}\n",
    "    print(label, \"weights:\", {k: round(v, 2) for k, v in W.items() if v > 0})\n",
    "    pd_ = sum(W[n] * CAL[n][\"dev\"] for n in names); pt_ = sum(W[n] * CAL[n][\"test\"] for n in names)\n",
    "    r = finalize(pd_, Y_dv, pt_, label=label); r[\"members\"] = [n for n in names if W[n] > 0]; r[\"weights\"] = W; r[\"_pd\"] = pd_; r[\"_pt\"] = pt_\n",
    "    return r\n",
    "\n",
    "ENS = {}\n",
    "ENS[\"ens_all_greedy\"] = make_ens(avail, \"greedy\", \"ens_all_greedy\")\n",
    "ENS[\"ens_all_mean\"] = make_ens(avail, \"mean\", \"ens_all_mean\")\n",
    "if len(neural) >= 1:\n",
    "    ENS[\"ens_neural_greedy\"] = make_ens(neural, \"greedy\", \"ens_neural_greedy\")\n",
    "    ENS[\"ens_neural_mean\"] = make_ens(neural, \"mean\", \"ens_neural_mean\")\n",
    "\n",
    "CANDS = {**SINGLE, **ENS}\n",
    "\n",
    "# ---- post-processing: every document gets at least one statute (kept per candidate only if it raises dev macro-F1) ----\n",
    "def atleast_one(pred, P):\n",
    "    pred = pred.copy(); e = ~pred.any(1)\n",
    "    if e.any(): pred[np.nonzero(e)[0], P[e].argmax(1)] = True\n",
    "    return pred\n",
    "_Yb = Y_dv > 0.5\n",
    "for k in list(CANDS):\n",
    "    r = CANDS[k] = dict(CANDS[k])\n",
    "    base = float(f1_per_label(_Yb, r[\"dev_pred\"]).mean()); alt_p = atleast_one(r[\"dev_pred\"], r[\"_pd\"]); alt = float(f1_per_label(_Yb, alt_p).mean())\n",
    "    if alt > base:\n",
    "        r[\"test_pred\"] = atleast_one(r[\"test_pred\"], r[\"_pt\"]); r[\"dev_pred\"] = alt_p\n",
    "        r[\"dev_tuned\"] = dict(r[\"dev_tuned\"], macro_f1=r[\"dev_tuned\"][\"macro_f1\"] + (alt - base))\n",
    "        print(f\"  at-least-one fix kept for {k}: +{alt-base:.4f}\")\n",
    "def score(k): return CANDS[k][\"dev_tuned\"][\"macro_f1\"] + (0.003 if k.startswith(\"ens\") else 0.0)\n",
    "FINAL_NAME = max(CANDS, key=score); FINAL = CANDS[FINAL_NAME]\n",
    "NEURAL_CANDS = [k for k, v in CANDS.items() if all(not m.startswith(\"lexical\") for m in v[\"members\"])]\n",
    "FINAL_NEURAL_NAME = max(NEURAL_CANDS, key=score); FINAL_NEURAL = CANDS[FINAL_NEURAL_NAME]\n",
    "print(f\"\\nFINAL submission        = {FINAL_NAME} | dev tuned macro-F1 {FINAL['dev_tuned']['macro_f1']:.4f} micro-F1 {FINAL['dev_tuned']['micro_f1']:.4f} | members {FINAL['members']}\")\n",
    "print(f\"FINAL neural-only (no lexical) = {FINAL_NEURAL_NAME} | dev tuned macro-F1 {FINAL_NEURAL['dev_tuned']['macro_f1']:.4f} | members {FINAL_NEURAL['members']}\")"
   ],
   "outputs": [],
   "execution_count": null
